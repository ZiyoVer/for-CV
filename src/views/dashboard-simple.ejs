<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>STT Dashboard</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* Header */
        .header {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            padding: 25px 35px;
            border-radius: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        }

        h1 {
            font-size: 32px;
            font-weight: 700;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        h2 {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 20px;
            color: #2d3748;
        }

        /* Buttons */
        .btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #ffffff;
            border: none;
            padding: 12px 28px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            border-radius: 12px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.6);
        }

        .btn-outline {
            background: white;
            color: #667eea;
            border: 2px solid #667eea;
            box-shadow: none;
        }

        .btn-outline:hover {
            background: #667eea;
            color: white;
        }

        .btn-small {
            padding: 8px 16px;
            font-size: 13px;
        }

        /* Stats */
        .stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.15);
        }

        .stat-card.accepted::before {
            background: linear-gradient(90deg, #11998e 0%, #38ef7d 100%);
        }

        .stat-card.rejected::before {
            background: linear-gradient(90deg, #eb3349 0%, #f45c43 100%);
        }

        .stat-card.pending::before {
            background: linear-gradient(90deg, #f093fb 0%, #f5576c 100%);
        }

        .stat-label {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #718096;
            margin-bottom: 12px;
        }

        .stat-value {
            font-size: 48px;
            font-weight: 700;
            margin-bottom: 5px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .stat-card.accepted .stat-value {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .stat-card.rejected .stat-value {
            background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .stat-card.pending .stat-value {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .stat-subtext {
            font-size: 13px;
            color: #a0aec0;
        }

        /* Card */
        .card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            padding: 30px;
            border-radius: 20px;
            margin-bottom: 25px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        }

        /* Table */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th {
            text-align: left;
            padding: 15px 12px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #718096;
            border-bottom: 2px solid #e2e8f0;
        }

        td {
            padding: 18px 12px;
            border-bottom: 1px solid #f7fafc;
            font-size: 14px;
            color: #2d3748;
        }

        tbody tr {
            transition: all 0.2s ease;
        }

        tbody tr:hover {
            background: #f7fafc;
        }

        /* Forms */
        input[type="text"],
        input[type="number"],
        input[type="file"] {
            border: 2px solid #e2e8f0;
            padding: 12px 16px;
            font-size: 14px;
            background: white;
            color: #2d3748;
            border-radius: 10px;
            font-family: inherit;
            transition: all 0.3s ease;
        }

        input[type="text"]:focus,
        input[type="number"]:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

        .form-inline {
            display: flex;
            gap: 15px;
            align-items: center;
            flex-wrap: wrap;
            margin-top: 20px;
        }

        .form-inline input[type="text"],
        .form-inline input[type="number"] {
            flex: 1;
            min-width: 200px;
        }

        label {
            font-size: 14px;
            font-weight: 600;
            color: #4a5568;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* User Actions */
        .user-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        /* Expandable Forms */
        .expandable-form {
            display: none;
            margin-top: 15px;
            padding: 20px;
            border-radius: 12px;
            background: #f7fafc;
            border: 2px solid #e2e8f0;
        }

        .expandable-form.show {
            display: block;
            animation: slideDown 0.3s ease;
        }

        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .stats {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 640px) {
            body {
                padding: 15px;
            }

            .stats {
                grid-template-columns: 1fr;
            }

            .header {
                flex-direction: column;
                gap: 15px;
                text-align: center;
            }

            h1 {
                font-size: 24px;
            }

            .stat-value {
                font-size: 36px;
            }
        }
    </style>
</head>
<body>

<div class="container">
    <!-- Header -->
    <div class="header">
        <h1>STT ADMIN</h1>
        <a href="/logout" class="btn">Chiqish</a>
    </div>

    <!-- Stats -->
    <div class="stats">
        <div class="stat-card">
            <div class="stat-label">Total</div>
            <div class="stat-value"><%= stats.totalChecked %></div>
            <div class="stat-subtext">tekshirilgan</div>
        </div>
        <div class="stat-card accepted">
            <div class="stat-label">Accepted</div>
            <div class="stat-value"><%= stats.totalAccepted %></div>
            <div class="stat-subtext"><%= stats.checkedDuration %></div>
        </div>
        <div class="stat-card rejected">
            <div class="stat-label">Rejected</div>
            <div class="stat-value"><%= stats.totalRejected %></div>
            <div class="stat-subtext">rad etilgan</div>
        </div>
        <div class="stat-card pending">
            <div class="stat-label">Pending</div>
            <div class="stat-value"><%= stats.pending %></div>
            <div class="stat-subtext"><%= stats.pendingDuration %></div>
        </div>
    </div>

    <!-- Upload -->
    <div class="card">
        <h2>☁️ Audio Yuklash</h2>
        <form action="/transcription/upload" method="POST" enctype="multipart/form-data" style="display: flex; gap: 15px; align-items: center; margin-top: 20px;">
            <input type="file" name="audioFiles" multiple accept="audio/*" required style="flex: 1;">
            <button type="submit" class="btn">Yuklash</button>
        </form>
    </div>

    <!-- Add User -->
    <div class="card">
        <h2>➕ Yangi Foydalanuvchi</h2>
        <form action="/users/add" method="POST" class="form-inline">
            <input type="number" name="telegram_id" placeholder="Telegram ID" required>
            <input type="text" name="full_name" placeholder="Ism Familiya" required>
            <label>
                <input type="checkbox" name="is_admin">
                Admin
            </label>
            <button type="submit" class="btn">Qo'shish</button>
        </form>
    </div>

    <!-- Users Table -->
    <div class="card">
        <h2>👥 Foydalanuvchilar (<%= users.length %>)</h2>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Ism</th>
                    <th>Bugun</th>
                    <th>OK</th>
                    <th>NO</th>
                    <th>Balans</th>
                    <th>Amallar</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(user => { %>
                <tr>
                    <td style="font-family: monospace; font-weight: 600;"><%= user.telegram_id %></td>
                    <td style="font-weight: 500;">
                        <%= user.full_name %>
                        <% if(user.is_admin) { %> <span style="color: #667eea;">●</span><% } %>
                    </td>
                    <td>
                        <% if(user.checks_today > 0) { %>
                            <span style="color: #38ef7d; font-weight: 700;">+<%= user.checks_today %></span>
                        <% } else { %>—<% } %>
                    </td>
                    <td><%= user.total_accepted || 0 %></td>
                    <td><%= user.total_rejected || 0 %></td>
                    <td style="font-weight: 600;"><%= user.balance.toLocaleString() %> so'm</td>
                    <td>
                        <div class="user-actions">
                            <a href="/review/<%= user.telegram_id %>" class="btn btn-small btn-outline">Review</a>
                            <button type="button" class="btn btn-small btn-outline" onclick="toggle('balance-<%= user.telegram_id %>')">Balans</button>
                            <form action="/users/payout/<%= user.telegram_id %>" method="POST" style="display: inline; margin: 0;" onsubmit="return confirm('To\'lov tasdiqlaysizmi?')">
                                <button type="submit" class="btn btn-small btn-outline">To'lov</button>
                            </form>
                            <button type="button" class="btn btn-small btn-outline" onclick="toggle('edit-<%= user.telegram_id %>')">Edit</button>
                            <form action="/users/delete/<%= user.telegram_id %>" method="POST" style="display: inline; margin: 0;" onsubmit="return confirm('O\'chirish?')">
                                <button type="submit" class="btn btn-small">Delete</button>
                            </form>
                        </div>

                        <!-- Balance Form -->
                        <div id="balance-<%= user.telegram_id %>" class="expandable-form">
                            <form action="/users/add-balance/<%= user.telegram_id %>" method="POST" class="form-inline" style="margin: 0;">
                                <input type="number" name="amount" placeholder="Summa (so'm)" required style="flex: 1;">
                                <button type="submit" class="btn btn-small">Qo'shish</button>
                                <button type="button" class="btn btn-small btn-outline" onclick="toggle('balance-<%= user.telegram_id %>')">Bekor</button>
                            </form>
                        </div>

                        <!-- Edit Form -->
                        <div id="edit-<%= user.telegram_id %>" class="expandable-form">
                            <form action="/users/update/<%= user.telegram_id %>" method="POST" class="form-inline" style="margin: 0;">
                                <input type="text" name="full_name" value="<%= user.full_name %>" required style="flex: 1;">
                                <label>
                                    <input type="checkbox" name="is_admin" <%= user.is_admin ? 'checked' : '' %>>
                                    Admin
                                </label>
                                <button type="submit" class="btn btn-small">Saqlash</button>
                                <button type="button" class="btn btn-small btn-outline" onclick="toggle('edit-<%= user.telegram_id %>')">Bekor</button>
                            </form>
                        </div>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<script>
function toggle(id) {
    var el = document.getElementById(id);
    if (el.classList.contains('show')) {
        el.classList.remove('show');
    } else {
        el.classList.add('show');
    }
}
</script>

</body>
</html>
