<!DOCTYPE html>
<html lang="uz">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>STT Admin - Tekshirish</title>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'JetBrains Mono', monospace;
            background: #0a0a0a;
            min-height: 100vh;
            color: #e5e5e5;
        }

        .navbar {
            background: #111;
            border-bottom: 1px solid #222;
            padding: 16px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 14px;
            font-weight: 600;
            color: #fff;
        }

        .back-btn {
            color: #666;
            text-decoration: none;
            font-size: 13px;
            transition: color 0.2s;
        }

        .back-btn:hover {
            color: #fff;
        }

        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 48px 32px;
        }

        .user-header {
            border: 1px solid #222;
            background: #111;
            padding: 24px;
            margin-bottom: 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .user-info h2 {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 4px;
            color: #fff;
        }

        .user-info p {
            color: #666;
            font-size: 13px;
        }

        .balance-info {
            text-align: right;
        }

        .balance-value {
            font-size: 24px;
            font-weight: 700;
            color: #22c55e;
        }

        .balance-label {
            color: #666;
            font-size: 12px;
        }

        .section-title {
            font-size: 14px;
            font-weight: 600;
            color: #fff;
            margin-bottom: 16px;
        }

        .file-card {
            border: 1px solid #222;
            background: #111;
            margin-bottom: 16px;
        }

        .file-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px;
            border-bottom: 1px solid #222;
        }

        .file-key {
            font-size: 11px;
            color: #666;
            background: #0a0a0a;
            padding: 4px 8px;
        }

        .file-status {
            font-size: 11px;
            font-weight: 600;
            color: #22c55e;
        }

        .audio-player {
            padding: 16px;
            background: #0a0a0a;
            border-bottom: 1px solid #222;
        }

        audio {
            width: 100%;
            height: 40px;
            filter: invert(1);
        }

        .file-text {
            padding: 16px;
            font-size: 13px;
            line-height: 1.6;
            color: #ccc;
        }

        .file-text::before {
            content: "[*] ";
            color: #555;
        }

        .penalty-section {
            border: 1px solid #ef4444;
            background: rgba(239, 68, 68, 0.05);
            padding: 24px;
            text-align: center;
            margin-top: 32px;
        }

        .penalty-section h3 {
            font-size: 14px;
            color: #ef4444;
            margin-bottom: 8px;
        }

        .penalty-section p {
            color: #666;
            font-size: 13px;
            margin-bottom: 16px;
        }

        .btn {
            background: #fff;
            color: #000;
            border: none;
            padding: 12px 24px;
            font-size: 13px;
            font-weight: 500;
            font-family: 'JetBrains Mono', monospace;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            transition: opacity 0.2s;
        }

        .btn:hover {
            opacity: 0.8;
        }

        .btn-danger {
            background: #ef4444;
            color: #fff;
        }

        .empty-state {
            text-align: center;
            padding: 60px;
            color: #666;
            border: 1px solid #222;
            background: #111;
        }
    </style>
</head>

<body>
    <nav class="navbar">
        <div class="logo">STT Admin / Tekshirish</div>
        <a href="/dashboard" class="back-btn">← Orqaga</a>
    </nav>

    <div class="container">
        <div class="user-header">
            <div class="user-info">
                <h2>
                    <%= user.full_name %>
                </h2>
                <p>ID: <%= user.telegram_id %>
                </p>
            </div>
            <div class="balance-info">
                <div class="balance-value">
                    <%= user.balance || 0 %> so'm
                </div>
                <div class="balance-label">Joriy balans</div>
            </div>
        </div>

        <h3 class="section-title">5 ta Tasodifiy Tekshirilgan Audio</h3>

        <% if (files.length===0) { %>
            <div class="empty-state">
                <p>Bu foydalanuvchi hali hech narsa tekshirmagan.</p>
            </div>
            <% } else { %>
                <% files.forEach((file, index)=> { %>
                    <div class="file-card">
                        <div class="file-header">
                            <span class="file-key">
                                <%= file.file_key %>
                            </span>
                            <span class="file-status">✓ ACCEPTED</span>
                        </div>
                        <% if (file.audioUrl) { %>
                            <div class="audio-player">
                                <audio controls preload="none">
                                    <source src="<%= file.audioUrl %>" type="audio/wav">
                                    Brauzeringiz audio'ni qo'llab-quvvatlamaydi.
                                </audio>
                            </div>
                            <% } %>
                                <div class="file-text">
                                    <%= file.text %>
                                </div>
                    </div>
                    <% }); %>

                        <div class="penalty-section">
                            <h3>Xato topdingizmi?</h3>
                            <p>Agar yuqoridagi tekshiruvlarda xatolar bo'lsa, foydalanuvchi balansini 50% ga
                                kamaytiring.</p>
                            <form method="POST" action="/review/penalty/<%= user.telegram_id %>">
                                <button type="submit" class="btn btn-danger"
                                    onclick="return confirm('Balansni 50% ga kamaytirishni tasdiqlaysizmi?')">
                                    50% Jarima Qo'llash
                                </button>
                            </form>
                        </div>
                        <% } %>
    </div>
</body>

</html>