<!DOCTYPE html>
<html lang="uz">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>STT Admin - Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        :root {
            --bg: #ffffff;
            --text: #000000;
            --text-muted: #666666;
            --border: #e5e5e5;
            --card-bg: #ffffff;
            --hover-bg: #f5f5f5;
            --primary: #000000;
            --primary-text: #ffffff;
        }

        [data-theme="dark"] {
            --bg: #000000;
            --text: #ffffff;
            --text-muted: #a3a3a3;
            --border: #333333;
            --card-bg: #0a0a0a;
            --hover-bg: #1a1a1a;
            --primary: #ffffff;
            --primary-text: #000000;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            transition: background 0.2s, color 0.2s;
        }

        .navbar {
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            background: var(--bg);
            z-index: 100;
        }

        .brand {
            font-weight: 700;
            font-size: 18px;
        }

        .nav-actions {
            display: flex;
            gap: 16px;
            align-items: center;
        }

        .icon-btn {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text);
            padding: 8px;
            border-radius: 8px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }

        .icon-btn:hover {
            background: var(--hover-bg);
        }

        .container {
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .page-title {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .page-subtitle {
            color: var(--text-muted);
            font-size: 14px;
            margin-bottom: 40px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            padding: 24px;
            border-radius: 12px;
        }

        .stat-card.total {
            border-left: 4px solid #3b82f6;
        }

        .stat-card.accepted {
            border-left: 4px solid #22c55e;
        }

        .stat-card.rejected {
            border-left: 4px solid #ef4444;
        }

        .stat-card.pending {
            border-left: 4px solid #f59e0b;
        }

        .stat-label {
            font-size: 12px;
            text-transform: uppercase;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 12px;
        }

        .stat-value {
            font-size: 36px;
            font-weight: 700;
        }

        .stat-card.total .stat-value {
            color: #3b82f6;
        }

        .stat-card.accepted .stat-value {
            color: #22c55e;
        }

        .stat-card.rejected .stat-value {
            color: #ef4444;
        }

        .stat-card.pending .stat-value {
            color: #f59e0b;
        }

        .stat-subtext {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        .charts-row {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
            margin-bottom: 40px;
        }

        .chart-box {
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 24px;
            background: var(--card-bg);
            height: 350px;
        }

        .chart-title {
            font-weight: 600;
            font-size: 16px;
            margin-bottom: 20px;
        }

        .upload-area {
            border: 2px dashed var(--border);
            border-radius: 16px;
            padding: 40px;
            text-align: center;
            margin-bottom: 40px;
        }

        .table-section {
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 40px;
        }

        .table-header {
            padding: 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            text-align: left;
            padding: 16px 24px;
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            border-bottom: 1px solid var(--border);
            background: var(--hover-bg);
        }

        td {
            padding: 16px 24px;
            font-size: 14px;
            border-bottom: 1px solid var(--border);
        }

        tr:hover td {
            background: var(--hover-bg);
        }

        .btn {
            background: var(--primary);
            color: var(--primary-text);
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: opacity 0.2s;
        }

        .btn:hover {
            opacity: 0.8;
        }

        .btn-outline {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text);
        }

        .action-cell {
            display: flex;
            gap: 8px;
        }

        .action-btn {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--border);
            background: transparent;
            cursor: pointer;
            color: var(--text);
            transition: all 0.2s;
        }

        .action-btn:hover {
            background: var(--primary);
            color: var(--primary-text);
        }

        /* MODAL - FIXED VERSION */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(5px);
            z-index: 1000;
            display: none;
            align-items: center;
            justify-content: center;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal {
            background: var(--card-bg);
            padding: 32px;
            border-radius: 16px;
            width: 90%;
            max-width: 450px;
            border: 1px solid var(--border);
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
        }

        .modal-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 24px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 13px;
            font-weight: 600;
        }

        .form-input {
            width: 100%;
            padding: 12px;
            border: 1px solid var(--border);
            background: var(--bg);
            color: var(--text);
            border-radius: 8px;
            font-size: 14px;
        }

        .form-input:focus {
            outline: none;
            border-color: var(--text);
        }

        .modal-actions {
            margin-top: 24px;
            display: flex;
            gap: 12px;
        }

        .btn-full {
            flex: 1;
            justify-content: center;
        }

        @media (max-width: 1024px) {
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .charts-row {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 600px) {
            .stats-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <nav class="navbar">
        <div class="brand">STT ADMIN</div>
        <div class="nav-actions">
            <button class="icon-btn" onclick="toggleTheme()">
                <i data-lucide="moon" id="theme-icon"></i>
            </button>
            <a href="/logout" class="icon-btn">
                <i data-lucide="log-out"></i>
            </a>
        </div>
    </nav>

    <div class="container">
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Platforma statistikasi va foydalanuvchilar boshqaruvi</p>

        <!-- Stats -->
        <div class="stats-grid">
            <div class="stat-card total">
                <div class="stat-label">TOTAL CHECKED</div>
                <div class="stat-value"><%= stats.totalChecked %></div>
                <div class="stat-subtext">ta fayl tekshirildi</div>
            </div>
            <div class="stat-card accepted">
                <div class="stat-label">ACCEPTED</div>
                <div class="stat-value"><%= stats.totalAccepted %></div>
                <div class="stat-subtext"><%= stats.checkedDuration %></div>
            </div>
            <div class="stat-card rejected">
                <div class="stat-label">REJECTED</div>
                <div class="stat-value"><%= stats.totalRejected %></div>
                <div class="stat-subtext">ta fayl rad etildi</div>
            </div>
            <div class="stat-card pending">
                <div class="stat-label">PENDING</div>
                <div class="stat-value"><%= stats.pending %></div>
                <div class="stat-subtext"><%= stats.pendingDuration %></div>
            </div>
        </div>

        <!-- Charts -->
        <div class="charts-row">
            <div class="chart-box">
                <div class="chart-title">Umumiy Statistika (30 kun)</div>
                <canvas id="lifetimeChart"></canvas>
            </div>
            <div class="chart-box">
                <div class="chart-title">24 Soatlik Faollik</div>
                <canvas id="dailyChart"></canvas>
            </div>
        </div>

        <!-- Upload -->
        <div class="upload-area">
            <i data-lucide="upload-cloud" size="40" style="margin-bottom: 16px; opacity: 0.5;"></i>
            <h3 style="margin-bottom: 8px;">Audio Yuklash (Transkripsiya)</h3>
            <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 24px;">
                S3 ga audio fayllar yuklang (Max 100 ta)
            </p>
            <form action="/transcription/upload" method="POST" enctype="multipart/form-data">
                <input type="file" name="audioFiles" id="fileInput" multiple accept="audio/*" style="display: none;" onchange="updateFileCount()">
                <button type="button" class="btn btn-outline" onclick="document.getElementById('fileInput').click()">
                    Fayllarni Tanlash
                </button>
                <button type="submit" class="btn" style="margin-left: 8px;">Yuklash</button>
            </form>
            <p id="file-label" style="font-size: 13px; margin-top: 12px; color: var(--text-muted);"></p>
        </div>

        <!-- Users Table -->
        <div class="table-section">
            <div class="table-header">
                <h3>Foydalanuvchilar</h3>
                <button class="btn" onclick="openAddUserModal()">
                    <i data-lucide="user-plus" size="16"></i> Yangi Foydalanuvchi
                </button>
            </div>
            <div style="overflow-x: auto;">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Ism</th>
                            <th style="text-align: right;">Bugun</th>
                            <th style="text-align: right;">Jami Ok</th>
                            <th style="text-align: right;">Jami No</th>
                            <th style="text-align: right;">Balans</th>
                            <th style="text-align: right;">Amallar</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(user => { %>
                            <tr>
                                <td style="font-family: monospace;"><%= user.telegram_id %></td>
                                <td>
                                    <%= user.full_name %>
                                    <% if(user.is_admin) { %><i data-lucide="shield" size="12"></i><% } %>
                                </td>
                                <td style="text-align: right;">
                                    <% if (user.checks_today > 0) { %>
                                        <span style="color: #22c55e; font-weight: 600;">+<%= user.checks_today %></span>
                                    <% } else { %>
                                        <span style="color: var(--text-muted);">-</span>
                                    <% } %>
                                </td>
                                <td style="text-align: right;"><%= user.total_accepted || 0 %></td>
                                <td style="text-align: right;"><%= user.total_rejected || 0 %></td>
                                <td style="text-align: right; font-weight: 600;"><%= user.balance.toLocaleString() %> so'm</td>
                                <td>
                                    <div class="action-cell" style="justify-content: flex-end;">
                                        <button class="action-btn" title="Tekshirish" onclick="window.location.href='/review/<%= user.telegram_id %>'">
                                            <i data-lucide="headphones" size="14"></i>
                                        </button>
                                        <button class="action-btn" title="Balans qo'shish" onclick="openBalanceModal(<%= user.telegram_id %>, '<%= user.full_name %>')">
                                            <i data-lucide="coins" size="14"></i>
                                        </button>
                                        <button class="action-btn" title="To'lov" onclick="openPayoutModal(<%= user.telegram_id %>, '<%= user.full_name %>', <%= user.balance || 0 %>)">
                                            <i data-lucide="banknote" size="14"></i>
                                        </button>
                                        <button class="action-btn" title="Tahrirlash" onclick="openEditModal(<%= user.telegram_id %>, '<%= user.full_name %>', <%= user.is_admin ? 'true' : 'false' %>)">
                                            <i data-lucide="user-pen" size="14"></i>
                                        </button>
                                        <form action="/users/delete/<%= user.telegram_id %>" method="POST" onsubmit="return confirm('O\'chirishni tasdiqlaysizmi?');" style="margin:0; display:inline;">
                                            <button type="submit" class="action-btn" title="O'chirish" style="color: #ef4444;">
                                                <i data-lucide="trash-2" size="14"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Add User Modal -->
    <div id="addUserModal" class="modal-overlay" onclick="closeModalOnOutsideClick(event, 'addUserModal')">
        <div class="modal">
            <h3 class="modal-title">Yangi Foydalanuvchi</h3>
            <form action="/users/add" method="POST">
                <div class="form-group">
                    <label>Telegram ID</label>
                    <input type="number" name="telegram_id" class="form-input" required>
                </div>
                <div class="form-group">
                    <label>To'liq Ism</label>
                    <input type="text" name="full_name" class="form-input" required>
                </div>
                <div class="form-group" style="display: flex; gap: 8px; align-items: center;">
                    <input type="checkbox" name="is_admin" id="isAdmin">
                    <label for="isAdmin" style="margin:0; cursor: pointer;">Admin</label>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-outline btn-full" onclick="closeModal('addUserModal')">Bekor</button>
                    <button type="submit" class="btn btn-full">Qo'shish</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Balance Modal -->
    <div id="balanceModal" class="modal-overlay" onclick="closeModalOnOutsideClick(event, 'balanceModal')">
        <div class="modal">
            <h3 class="modal-title">Balans Qo'shish</h3>
            <p id="balanceUserName" style="margin-bottom: 20px; color: var(--text-muted);"></p>
            <form id="balanceForm" method="POST">
                <div class="form-group">
                    <label>Summa (so'm)</label>
                    <input type="number" name="amount" class="form-input" required placeholder="50000">
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-outline btn-full" onclick="closeModal('balanceModal')">Bekor</button>
                    <button type="submit" class="btn btn-full">Qo'shish</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Payout Modal -->
    <div id="payoutModal" class="modal-overlay" onclick="closeModalOnOutsideClick(event, 'payoutModal')">
        <div class="modal">
            <h3 class="modal-title">To'lovni Tasdiqlash</h3>
            <p style="margin-bottom: 8px;">Foydalanuvchi: <b id="payoutUserName"></b></p>
            <p style="margin-bottom: 24px;">Summa: <b id="payoutAmount"></b> so'm</p>
            <form id="payoutForm" method="POST">
                <div class="modal-actions">
                    <button type="button" class="btn btn-outline btn-full" onclick="closeModal('payoutModal')">Bekor</button>
                    <button type="submit" class="btn btn-full">To'lab Berildi</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Edit User Modal -->
    <div id="editModal" class="modal-overlay" onclick="closeModalOnOutsideClick(event, 'editModal')">
        <div class="modal">
            <h3 class="modal-title">Foydalanuvchini Tahrirlash</h3>
            <form id="editForm" method="POST">
                <div class="form-group">
                    <label>Telegram ID</label>
                    <input type="number" id="editTelegramId" class="form-input" disabled style="opacity: 0.6;">
                </div>
                <div class="form-group">
                    <label>To'liq Ism</label>
                    <input type="text" name="full_name" id="editFullName" class="form-input" required>
                </div>
                <div class="form-group" style="display: flex; gap: 8px; align-items: center;">
                    <input type="checkbox" name="is_admin" id="editIsAdmin">
                    <label for="editIsAdmin" style="margin:0; cursor: pointer;">Admin</label>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-outline btn-full" onclick="closeModal('editModal')">Bekor</button>
                    <button type="submit" class="btn btn-full">Saqlash</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Initialize Lucide icons
        lucide.createIcons();

        // Theme
        function toggleTheme() {
            const isDark = document.body.getAttribute('data-theme') === 'dark';
            if (isDark) {
                document.body.removeAttribute('data-theme');
                localStorage.setItem('theme', 'light');
                document.getElementById('theme-icon').setAttribute('data-lucide', 'moon');
            } else {
                document.body.setAttribute('data-theme', 'dark');
                localStorage.setItem('theme', 'dark');
                document.getElementById('theme-icon').setAttribute('data-lucide', 'sun');
            }
            lucide.createIcons();
        }

        if (localStorage.getItem('theme') === 'dark') {
            document.body.setAttribute('data-theme', 'dark');
            document.getElementById('theme-icon').setAttribute('data-lucide', 'sun');
        }

        // Modal Functions
        function openModal(id) {
            document.getElementById(id).classList.add('active');
        }

        function closeModal(id) {
            document.getElementById(id).classList.remove('active');
        }

        function closeModalOnOutsideClick(event, id) {
            if (event.target.id === id) {
                closeModal(id);
            }
        }

        // Add User Modal
        function openAddUserModal() {
            openModal('addUserModal');
        }

        // Balance Modal
        function openBalanceModal(userId, userName) {
            document.getElementById('balanceUserName').textContent = 'Foydalanuvchi: ' + userName;
            document.getElementById('balanceForm').action = '/users/add-balance/' + userId;
            openModal('balanceModal');
        }

        // Payout Modal
        function openPayoutModal(userId, userName, amount) {
            document.getElementById('payoutUserName').textContent = userName;
            document.getElementById('payoutAmount').textContent = amount.toLocaleString();
            document.getElementById('payoutForm').action = '/users/payout/' + userId;
            openModal('payoutModal');
        }

        // Edit Modal
        function openEditModal(userId, userName, isAdmin) {
            document.getElementById('editTelegramId').value = userId;
            document.getElementById('editFullName').value = userName;
            document.getElementById('editIsAdmin').checked = isAdmin;
            document.getElementById('editForm').action = '/users/update/' + userId;
            openModal('editModal');
        }

        // File Upload
        function updateFileCount() {
            const input = document.getElementById('fileInput');
            const label = document.getElementById('file-label');
            if (input.files && input.files.length > 0) {
                label.textContent = input.files.length + " ta fayl tanlandi";
            } else {
                label.textContent = "";
            }
        }

        // Charts
        document.addEventListener('DOMContentLoaded', () => {
            const chartData = <%= JSON.stringify(typeof chartData !== 'undefined' ? chartData : []) %>;
            const lifetimeStats = <%= JSON.stringify(typeof lifetimeStats !== 'undefined' ? lifetimeStats : []) %>;

            // Lifetime Chart
            const ctxLifetime = document.getElementById('lifetimeChart');
            if (ctxLifetime) {
                new Chart(ctxLifetime.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: lifetimeStats.map(d => new Date(d.day).toLocaleDateString('uz-UZ', { day: '2-digit', month: '2-digit' })),
                        datasets: [
                            {
                                label: 'Qabul',
                                data: lifetimeStats.map(d => d.accepted),
                                backgroundColor: '#22c55e',
                                borderRadius: 4,
                                stack: 'Stack 0'
                            },
                            {
                                label: 'Rad',
                                data: lifetimeStats.map(d => d.rejected),
                                backgroundColor: '#ef4444',
                                borderRadius: 4,
                                stack: 'Stack 0'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            x: { stacked: true, grid: { display: false } },
                            y: { stacked: true, beginAtZero: true }
                        },
                        plugins: { legend: { position: 'top' } }
                    }
                });
            }

            // Daily Chart
            const ctxDaily = document.getElementById('dailyChart');
            if (ctxDaily) {
                new Chart(ctxDaily.getContext('2d'), {
                    type: 'line',
                    data: {
                        labels: chartData.map(d => new Date(d.hour).getHours() + ':00'),
                        datasets: [{
                            label: 'Tekshiruvlar',
                            data: chartData.map(d => d.count),
                            borderColor: '#3b82f6',
                            backgroundColor: 'rgba(59, 130, 246, 0.1)',
                            tension: 0.4,
                            fill: true,
                            pointRadius: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { grid: { display: false } },
                            y: { beginAtZero: true }
                        }
                    }
                });
            }

            lucide.createIcons();
        });
    </script>
</body>

</html>
