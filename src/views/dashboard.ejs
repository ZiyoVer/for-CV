<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>STT Dashboard</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
            background: #ffffff;
            color: #000000;
            line-height: 1.6;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        /* Header */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 30px;
            border-bottom: 2px solid #000000;
            margin-bottom: 40px;
        }

        h1 {
            font-size: 32px;
            font-weight: 700;
            letter-spacing: -1px;
        }

        h2 {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Buttons */
        .btn {
            background: #000000;
            color: #ffffff;
            border: 2px solid #000000;
            padding: 12px 24px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            transition: all 0.2s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn:hover {
            background: #ffffff;
            color: #000000;
        }

        .btn-outline {
            background: #ffffff;
            color: #000000;
            border: 2px solid #000000;
        }

        .btn-outline:hover {
            background: #000000;
            color: #ffffff;
        }

        .btn-small {
            padding: 8px 16px;
            font-size: 12px;
        }

        /* Stats */
        .stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 50px;
        }

        .stat-card {
            border: 2px solid #000000;
            padding: 30px;
            background: #ffffff;
            transition: transform 0.2s ease;
        }

        .stat-card:hover {
            transform: translateY(-2px);
        }

        .stat-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
            color: #666666;
        }

        .stat-value {
            font-size: 48px;
            font-weight: 700;
            letter-spacing: -2px;
            margin-bottom: 5px;
        }

        .stat-subtext {
            font-size: 13px;
            color: #666666;
        }

        /* Card */
        .card {
            border: 2px solid #000000;
            padding: 30px;
            margin-bottom: 30px;
            background: #ffffff;
        }

        /* Table */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th {
            text-align: left;
            padding: 15px 10px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 2px solid #000000;
        }

        td {
            padding: 15px 10px;
            border-bottom: 1px solid #e0e0e0;
            font-size: 14px;
        }

        tbody tr:hover {
            background: #f9f9f9;
        }

        /* Forms */
        input[type="text"],
        input[type="number"],
        input[type="file"] {
            border: 2px solid #000000;
            padding: 10px 15px;
            font-size: 14px;
            background: #ffffff;
            color: #000000;
            font-family: inherit;
        }

        input[type="text"]:focus,
        input[type="number"]:focus {
            outline: none;
            border-color: #666666;
        }

        input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
        }

        .form-inline {
            display: flex;
            gap: 15px;
            align-items: center;
            flex-wrap: wrap;
            margin-top: 20px;
        }

        .form-inline input[type="text"],
        .form-inline input[type="number"] {
            flex: 1;
            min-width: 200px;
        }

        label {
            font-size: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* User Actions */
        .user-actions {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        /* Expandable Forms */
        .expandable-form {
            display: none;
            margin-top: 15px;
            padding: 20px;
            border: 2px solid #000000;
            background: #f9f9f9;
        }

        .expandable-form.show {
            display: block;
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .stats {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 640px) {
            .container {
                padding: 20px 15px;
            }

            .stats {
                grid-template-columns: 1fr;
            }

            .header {
                flex-direction: column;
                gap: 20px;
                align-items: flex-start;
            }

            h1 {
                font-size: 24px;
            }

            .stat-value {
                font-size: 36px;
            }
        }
    </style>
</head>
<body>

<div class="container">
    <!-- Header -->
    <div class="header">
        <h1>STT ADMIN</h1>
        <a href="/logout" class="btn">CHIQISH</a>
    </div>

    <!-- Stats -->
    <div class="stats">
        <div class="stat-card">
            <div class="stat-label">TOTAL</div>
            <div class="stat-value"><%= stats.totalChecked %></div>
            <div class="stat-subtext">tekshirilgan</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">ACCEPTED</div>
            <div class="stat-value"><%= stats.totalAccepted %></div>
            <div class="stat-subtext"><%= stats.checkedDuration %></div>
        </div>
        <div class="stat-card">
            <div class="stat-label">REJECTED</div>
            <div class="stat-value"><%= stats.totalRejected %></div>
            <div class="stat-subtext">rad etilgan</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">PENDING</div>
            <div class="stat-value"><%= stats.pending %></div>
            <div class="stat-subtext"><%= stats.pendingDuration %></div>
        </div>
    </div>

    <!-- Upload -->
    <div class="card">
        <h2>Audio Yuklash</h2>
        <form action="/transcription/upload" method="POST" enctype="multipart/form-data" style="display: flex; gap: 15px; align-items: center; margin-top: 20px;">
            <input type="file" name="audioFiles" multiple accept="audio/*" required style="flex: 1;">
            <button type="submit" class="btn">YUKLASH</button>
        </form>
    </div>

    <!-- Add User -->
    <div class="card">
        <h2>Yangi Foydalanuvchi</h2>
        <form action="/users/add" method="POST" class="form-inline">
            <input type="number" name="telegram_id" placeholder="Telegram ID" required>
            <input type="text" name="full_name" placeholder="Ism Familiya" required>
            <label>
                <input type="checkbox" name="is_admin">
                Admin
            </label>
            <button type="submit" class="btn">QO'SHISH</button>
        </form>
    </div>

    <!-- Users Table -->
    <div class="card">
        <h2>Foydalanuvchilar (<%= users.length %>)</h2>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>ISM</th>
                    <th>BUGUN</th>
                    <th>OK</th>
                    <th>NO</th>
                    <th>BALANS</th>
                    <th>AMALLAR</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(user => { %>
                <tr>
                    <td style="font-family: monospace; font-weight: 600;"><%= user.telegram_id %></td>
                    <td style="font-weight: 500;">
                        <%= user.full_name %>
                        <% if(user.is_admin) { %> <span style="font-size: 10px;">●</span><% } %>
                    </td>
                    <td>
                        <% if(user.checks_today > 0) { %>
                            <strong>+<%= user.checks_today %></strong>
                        <% } else { %>—<% } %>
                    </td>
                    <td><%= user.total_accepted || 0 %></td>
                    <td><%= user.total_rejected || 0 %></td>
                    <td style="font-weight: 600;"><%= user.balance.toLocaleString() %></td>
                    <td>
                        <div class="user-actions">
                            <a href="/review/<%= user.telegram_id %>" class="btn btn-small btn-outline">Review</a>
                            <button type="button" class="btn btn-small btn-outline" onclick="toggle('balance-<%= user.telegram_id %>')">Balans</button>
                            <form action="/users/payout/<%= user.telegram_id %>" method="POST" style="display: inline; margin: 0;" onsubmit="return confirm('To\'lov tasdiqlaysizmi?')">
                                <button type="submit" class="btn btn-small btn-outline">To'lov</button>
                            </form>
                            <button type="button" class="btn btn-small btn-outline" onclick="toggle('edit-<%= user.telegram_id %>')">Edit</button>
                            <form action="/users/delete/<%= user.telegram_id %>" method="POST" style="display: inline; margin: 0;" onsubmit="return confirm('O\'chirish?')">
                                <button type="submit" class="btn btn-small">Delete</button>
                            </form>
                        </div>

                        <!-- Balance Form -->
                        <div id="balance-<%= user.telegram_id %>" class="expandable-form">
                            <form action="/users/add-balance/<%= user.telegram_id %>" method="POST" class="form-inline" style="margin: 0;">
                                <input type="number" name="amount" placeholder="Summa (so'm)" required style="flex: 1;">
                                <button type="submit" class="btn btn-small">Qo'shish</button>
                                <button type="button" class="btn btn-small btn-outline" onclick="toggle('balance-<%= user.telegram_id %>')">Bekor</button>
                            </form>
                        </div>

                        <!-- Edit Form -->
                        <div id="edit-<%= user.telegram_id %>" class="expandable-form">
                            <form action="/users/update/<%= user.telegram_id %>" method="POST" class="form-inline" style="margin: 0;">
                                <input type="text" name="full_name" value="<%= user.full_name %>" required style="flex: 1;">
                                <label>
                                    <input type="checkbox" name="is_admin" <%= user.is_admin ? 'checked' : '' %>>
                                    Admin
                                </label>
                                <button type="submit" class="btn btn-small">Saqlash</button>
                                <button type="button" class="btn btn-small btn-outline" onclick="toggle('edit-<%= user.telegram_id %>')">Bekor</button>
                            </form>
                        </div>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<script>
function toggle(id) {
    var el = document.getElementById(id);
    if (el.classList.contains('show')) {
        el.classList.remove('show');
    } else {
        el.classList.add('show');
    }
}
</script>

</body>
</html>
