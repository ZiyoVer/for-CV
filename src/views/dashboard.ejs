<!DOCTYPE html>
<html lang="uz">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>STT Admin - Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'JetBrains Mono', monospace;
            background: #0a0a0a;
            min-height: 100vh;
            color: #e5e5e5;
        }

        .navbar {
            background: #111;
            border-bottom: 1px solid #222;
            padding: 16px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 14px;
            font-weight: 600;
            color: #fff;
        }

        .logout-btn {
            color: #666;
            text-decoration: none;
            font-size: 13px;
            transition: color 0.2s;
        }

        .logout-btn:hover {
            color: #fff;
        }

        .container {
            max-width: 1100px;
            margin: 0 auto;
            padding: 48px 32px;
        }

        .section-title {
            font-size: 14px;
            font-weight: 600;
            color: #fff;
            margin-bottom: 8px;
        }

        .section-desc {
            font-size: 13px;
            color: #666;
            margin-bottom: 32px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1px;
            background: #222;
            border: 1px solid #222;
            margin-bottom: 48px;
        }

        .stat-card {
            background: #111;
            padding: 24px;
        }

        .stat-label {
            font-size: 12px;
            color: #666;
            margin-bottom: 8px;
        }

        .stat-value {
            font-size: 32px;
            font-weight: 700;
            color: #fff;
        }

        .stat-value.green {
            color: #22c55e;
        }

        .stat-value.red {
            color: #ef4444;
        }

        .stat-value.yellow {
            color: #eab308;
        }

        .feature-list {
            margin-bottom: 48px;
        }

        .feature-item {
            display: flex;
            gap: 12px;
            margin-bottom: 10px;
            font-size: 13px;
            color: #888;
        }

        .feature-item span:first-child {
            color: #555;
        }

        .feature-item strong {
            color: #e5e5e5;
        }

        .users-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }

        .btn {
            background: #fff;
            color: #000;
            border: none;
            padding: 10px 20px;
            font-size: 13px;
            font-weight: 500;
            font-family: 'JetBrains Mono', monospace;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            transition: opacity 0.2s;
        }

        .btn:hover {
            opacity: 0.8;
        }

        .btn-outline {
            background: transparent;
            color: #888;
            border: 1px solid #333;
        }

        .btn-outline:hover {
            border-color: #fff;
            color: #fff;
        }

        .btn-success {
            background: #22c55e;
            color: #000;
        }

        .btn-warning {
            background: #eab308;
            color: #000;
        }

        .btn-sm {
            padding: 6px 12px;
            font-size: 11px;
        }

        .table-container {
            border: 1px solid #222;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 14px 16px;
            text-align: left;
            font-size: 13px;
        }

        th {
            background: #111;
            color: #666;
            font-weight: 500;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid #222;
        }

        tr {
            background: #0a0a0a;
        }

        tr:hover {
            background: #111;
        }

        tr:not(:last-child) td {
            border-bottom: 1px solid #1a1a1a;
        }

        .balance {
            color: #22c55e;
            font-weight: 600;
        }

        .admin-badge {
            color: #eab308;
            font-size: 11px;
        }

        code {
            background: #1a1a1a;
            padding: 2px 6px;
            font-size: 12px;
            color: #888;
        }

        .actions {
            display: flex;
            gap: 8px;
        }

        /* Modal */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.8);
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal {
            background: #111;
            border: 1px solid #222;
            padding: 32px;
            width: 100%;
            max-width: 420px;
        }

        .modal h3 {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 24px;
            color: #fff;
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-group label {
            display: block;
            color: #888;
            margin-bottom: 8px;
            font-size: 12px;
        }

        .form-group input {
            width: 100%;
            padding: 12px;
            background: #0a0a0a;
            border: 1px solid #333;
            color: #fff;
            font-size: 13px;
            font-family: 'JetBrains Mono', monospace;
        }

        .form-group input:focus {
            outline: none;
            border-color: #fff;
        }

        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .checkbox-group input[type="checkbox"] {
            width: 16px;
            height: 16px;
        }

        .modal-actions {
            display: flex;
            gap: 12px;
            margin-top: 24px;
        }

        .modal-actions .btn {
            flex: 1;
            justify-content: center;
        }

        @media (max-width: 800px) {
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
</head>

<body>
    <nav class="navbar">
        <div class="logo">STT Admin</div>
        <a href="/logout" class="logout-btn">Chiqish →</a>
    </nav>

    <div class="container">
        <h2 class="section-title">Dashboard</h2>
        <p class="section-desc">STT Tekshiruv tizimi umumiy statistikasi</p>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-label">Jami Tekshirilgan</div>
                <div class="stat-value">
                    <%= stats.totalChecked %>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Qabul Qilingan</div>
                <div class="stat-value green">
                    <%= stats.totalAccepted %>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Rad Etilgan</div>
                <div class="stat-value red">
                    <%= stats.totalRejected %>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Kutilmoqda</div>
                <div class="stat-value yellow">
                    <%= stats.pending %>
                </div>
            </div>
        </div>

        <div class="feature-list">
            <div class="feature-item">
                <span>[*]</span>
                <span><strong>Annotatorlar</strong> Audio va matnlarni tekshiruvchi jamoangiz</span>
            </div>
            <div class="feature-item">
                <span>[*]</span>
                <span><strong>20 bepul</strong> Har 24 soatda birinchi 20 tekshiruv bepul</span>
            </div>
            <div class="feature-item">
                <span>[*]</span>
                <span><strong>50 so'm</strong> Keyingi har bir tekshiruv uchun to'lov</span>
            </div>
        </div>

        <div class="users-header">
            <h2 class="section-title">Foydalanuvchilar</h2>
            <button class="btn" onclick="openModal()">+ Yangi Qo'shish</button>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Ism</th>
                        <th>Bugun</th>
                        <th>Jami ✓</th>
                        <th>Jami ✗</th>
                        <th>Balans</th>
                        <th>Amallar</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(user=> { %>
                        <tr>
                            <td><code><%= user.telegram_id %></code></td>
                            <td>
                                <%= user.full_name %>
                                    <% if (user.is_admin) { %><span class="admin-badge">ADMIN</span>
                                        <% } %>
                            </td>
                            <td>
                                <%= user.checks_today %>
                            </td>
                            <td>
                                <%= user.total_accepted %>
                            </td>
                            <td>
                                <%= user.total_rejected %>
                            </td>
                            <td class="balance">
                                <%= user.balance || 0 %> so'm
                            </td>
                            <td class="actions">
                                <a href="/review/<%= user.telegram_id %>" class="btn btn-outline btn-sm">Tekshirish</a>
                                <button class="btn btn-warning btn-sm"
                                    onclick="openBalanceModal(<%= user.telegram_id %>, '<%= user.full_name %>')">+
                                    Balans</button>
                                <form method="POST" action="/users/payout/<%= user.telegram_id %>"
                                    style="display:inline;">
                                    <button type="submit" class="btn btn-success btn-sm"
                                        onclick="return confirm('Pul to\'lashni tasdiqlaysizmi?')">To'lash</button>
                                </form>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Add User Modal -->
    <div class="modal-overlay" id="addUserModal">
        <div class="modal">
            <h3>Yangi Foydalanuvchi</h3>
            <form method="POST" action="/users/add">
                <div class="form-group">
                    <label>Telegram ID</label>
                    <input type="number" name="telegram_id" placeholder="123456789" required>
                </div>
                <div class="form-group">
                    <label>To'liq Ism</label>
                    <input type="text" name="full_name" placeholder="Ism Familiya" required>
                </div>
                <div class="form-group">
                    <div class="checkbox-group">
                        <input type="checkbox" name="is_admin" id="is_admin">
                        <label for="is_admin" style="margin: 0;">Admin qilish</label>
                    </div>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-outline" onclick="closeModal()">Bekor</button>
                    <button type="submit" class="btn">Qo'shish →</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Add Balance Modal -->
    <div class="modal-overlay" id="balanceModal">
        <div class="modal">
            <h3>Balans Qo'shish</h3>
            <p style="color: #888; font-size: 13px; margin-bottom: 16px;">Foydalanuvchi: <span id="balanceUserName"
                    style="color: #fff;"></span></p>
            <form method="POST" id="balanceForm">
                <div class="form-group">
                    <label>Qo'shiladigan summa (so'm)</label>
                    <input type="number" name="amount" placeholder="3150" required>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-outline" onclick="closeBalanceModal()">Bekor</button>
                    <button type="submit" class="btn">Qo'shish →</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openModal() {
            document.getElementById('addUserModal').classList.add('active');
        }
        function closeModal() {
            document.getElementById('addUserModal').classList.remove('active');
        }
        document.getElementById('addUserModal').addEventListener('click', (e) => {
            if (e.target.classList.contains('modal-overlay')) closeModal();
        });

        function openBalanceModal(userId, userName) {
            document.getElementById('balanceUserName').textContent = userName;
            document.getElementById('balanceForm').action = '/users/add-balance/' + userId;
            document.getElementById('balanceModal').classList.add('active');
        }
        function closeBalanceModal() {
            document.getElementById('balanceModal').classList.remove('active');
        }
        document.getElementById('balanceModal').addEventListener('click', (e) => {
            if (e.target.classList.contains('modal-overlay')) closeBalanceModal();
        });
    </script>
</body>

</html>