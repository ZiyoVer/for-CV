    <script>
        // ─── Theme Toggle ───
        (function () {
            var saved = localStorage.getItem('theme');
            if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
            updateThemeIcon();
        })();

        function toggleTheme() {
            var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            document.documentElement.setAttribute('data-theme', isDark ? 'light' : 'dark');
            localStorage.setItem('theme', isDark ? 'light' : 'dark');
            updateThemeIcon();
        }

        function updateThemeIcon() {
            var icon = document.getElementById('themeIcon');
            if (!icon) return;
            var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            icon.textContent = isDark ? '\u2600' : '\u263D';
        }

        // Toggle expandable forms
        function toggle(id) {
            console.log('Toggle called for:', id);
            var el = document.getElementById(id);
            if (!el) {
                console.error('Element not found:', id);
                return;
            }

            if (el.classList.contains('show')) {
                el.classList.remove('show');
                el.style.display = 'none';
            } else {
                // Close other open forms
                document.querySelectorAll('.expandable-form.show').forEach(function (form) {
                    form.classList.remove('show');
                    form.style.display = 'none';
                });
                el.classList.add('show');
                el.style.display = 'block';

                // Focus on first input
                var firstInput = el.querySelector('input');
                if (firstInput) {
                    setTimeout(function () { firstInput.focus(); }, 100);
                }
            }
        }

        // Update file name display
        function updateFileName(input) {
            var fileNameDiv = document.getElementById('fileName');
            if (input.files && input.files.length > 0) {
                var fileNames = Array.from(input.files).map(function (f) { return f.name; }).join(', ');
                fileNameDiv.textContent = fileNames.length > 60 ? fileNames.substring(0, 60) + '...' : fileNames;
                fileNameDiv.style.display = 'block';
            } else {
                fileNameDiv.style.display = 'none';
            }
        }

        // File upload click handler
        function openFilePicker() {
            document.getElementById('audioFiles').click();
        }

        // Chart.js Configuration
        const chartColors = {
            primary: '#d97757',
            secondary: '#e07a5f',
            success: '#10b981',
            error: '#ef4444',
            warning: '#f59e0b',
            neutral: '#888888',
            background: ['#d97757', '#10b981', '#ef4444', '#f59e0b', '#6366f1', '#8b5cf6', '#ec4899']
        };

        const isDarkMode = document.documentElement.getAttribute('data-theme') === 'dark';
        const gridColor = isDarkMode ? 'rgba(255, 255, 255, 0.1)' : '#f0f0f0';
        const textColor = isDarkMode ? '#a0a0a0' : '#888';

        const chartOptions = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: true,
                    position: 'bottom',
                    labels: {
                        usePointStyle: true,
                        padding: 20,
                        font: {
                            size: 12,
                            family: '-apple-system, BlinkMacSystemFont, sans-serif'
                        },
                        color: textColor
                    }
                },
                tooltip: {
                    backgroundColor: isDarkMode ? '#1a1a1a' : '#1a1a1a',
                    padding: 12,
                    cornerRadius: 8,
                    titleFont: { size: 13, weight: '600' },
                    bodyFont: { size: 12 }
                }
            },
            scales: {
                x: {
                    grid: { display: false, color: gridColor },
                    ticks: { font: { size: 11 }, color: textColor }
                },
                y: {
                    beginAtZero: true,
                    grid: { color: gridColor },
                    ticks: { font: { size: 11 }, color: textColor }
                }
            }
        };

        // 1. Overall Statistics Chart (Bar Chart)
        const statsCtx = document.getElementById('statsChart').getContext('2d');
        const chartStats = new Chart(statsCtx, {
            type: 'bar',
            data: {
                labels: ['Pending', 'Transcription', 'Accepted', 'Rejected'],
                datasets: [{
                    label: 'Files',
                    data: [
                <%= stats.pending || 0 %>,
                <%= stats.transcriptionPending || 0 %>,
                <%= stats.totalAccepted || 0 %>,
                <%= stats.totalRejected || 0 %>
            ],
                    backgroundColor: [
                        chartColors.warning,
                        chartColors.secondary,
                        chartColors.success,
                        chartColors.error
                    ],
                    borderRadius: 6,
                    barThickness: 40
                }]
            },
            options: {
                ...chartOptions,
                plugins: {
                    ...chartOptions.plugins,
                    legend: { display: false }
                }
            }
        });

        // 2. User Activity Chart (Horizontal Bar Chart)
        const userActivityCtx = document.getElementById('userActivityChart').getContext('2d');
        const userData = <% - JSON.stringify(users || []).replace(/</g, '\\u003c') %>;
        const topUsers = userData.slice(0, 8).sort((a, b) => (b.total_accepted + b.total_rejected) - (a.total_accepted + a.total_rejected));

        const chartUserActivity = new Chart(userActivityCtx, {
            type: 'bar',
            data: {
                labels: topUsers.map(u => u.full_name.split(' ')[0]),
                datasets: [
                    {
                        label: 'Accepted',
                        data: topUsers.map(u => u.total_accepted || 0),
                        backgroundColor: chartColors.success,
                        borderRadius: 4
                    },
                    {
                        label: 'Rejected',
                        data: topUsers.map(u => u.total_rejected || 0),
                        backgroundColor: chartColors.error,
                        borderRadius: 4
                    }
                ]
            },
            options: {
                ...chartOptions,
                indexAxis: 'y',
                plugins: {
                    ...chartOptions.plugins,
                    legend: { position: 'top' }
                },
                scales: {
                    x: {
                        stacked: true,
                        grid: { display: false, color: gridColor },
                        ticks: { font: { size: 11 }, color: textColor }
                    },
                    y: {
                        stacked: true,
                        grid: { display: false },
                        ticks: { font: { size: 12 }, color: isDarkMode ? '#ffffff' : '#666' }
                    }
                }
            }
        });

        // 3. Timeline Chart (Line Chart with REAL data from database)
        const timelineCtx = document.getElementById('timelineChart').getContext('2d');
        const lifetimeData = <% - JSON.stringify(lifetimeStats || []).replace(/</g, '\\u003c') %>;

        // Format dates and prepare data
        const timelineLabels = lifetimeData.map(d => {
            const date = new Date(d.date || d.day);
            return date.toLocaleDateString('uz-UZ', { weekday: 'short', day: 'numeric' });
        });
        const timelineAccepted = lifetimeData.map(d => d.accepted || 0);
        const timelineRejected = lifetimeData.map(d => d.rejected || 0);

        const chartTimeline = new Chart(timelineCtx, {
            type: 'line',
            data: {
                labels: timelineLabels.length > 0 ? timelineLabels : ['Ma\'lumot yo\'q'],
                datasets: [
                    {
                        label: 'Accepted',
                        data: timelineAccepted.length > 0 ? timelineAccepted : [0],
                        borderColor: chartColors.success,
                        backgroundColor: 'rgba(16, 185, 129, 0.1)',
                        fill: true,
                        tension: 0.4,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    },
                    {
                        label: 'Rejected',
                        data: timelineRejected.length > 0 ? timelineRejected : [0],
                        borderColor: chartColors.error,
                        backgroundColor: 'rgba(239, 68, 68, 0.1)',
                        fill: true,
                        tension: 0.4,
                        pointRadius: 4,
                        pointHoverRadius: 6
                    }
                ]
            },
            options: {
                ...chartOptions,
                plugins: {
                    ...chartOptions.plugins,
                    legend: { position: 'top', align: 'end' }
                },
                interaction: {
                    intersect: false,
                    mode: 'index'
                }
            }
        });

        // 4. Accept/Reject Ratio (Pie Chart)
        const ratioCtx = document.getElementById('ratioChart').getContext('2d');
        const totalChecked = <%= (stats.totalAccepted || 0) + (stats.totalRejected || 0) %>;
        const acceptedPct = <%= stats.totalAccepted || 0 %>;
        const rejectedPct = <%= stats.totalRejected || 0 %>;

        const chartRatio = new Chart(ratioCtx, {
            type: 'doughnut',
            data: {
                labels: ['Accepted', 'Rejected'],
                datasets: [{
                    data: [acceptedPct, rejectedPct],
                    backgroundColor: [chartColors.success, chartColors.error],
                    borderWidth: 0,
                    cutout: '65%'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            usePointStyle: true,
                            padding: 15,
                            generateLabels: function (chart) {
                                const data = chart.data;
                                const total = data.datasets[0].data.reduce((a, b) => a + b, 0);
                                return data.labels.map((label, i) => {
                                    const value = data.datasets[0].data[i];
                                    const percentage = total > 0 ? Math.round((value / total) * 100) : 0;
                                    return {
                                        text: `${label}: ${value} (${percentage}%)`,
                                        fillStyle: data.datasets[0].backgroundColor[i],
                                        strokeStyle: data.datasets[0].backgroundColor[i],
                                        lineWidth: 0,
                                        pointStyle: 'circle',
                                        hidden: false,
                                        index: i
                                    };
                                });
                            }
                        }
                    }
                }
            }
        });

        // 5. Top Contributors (Pie Chart)
        const contributorsCtx = document.getElementById('contributorsChart').getContext('2d');
        const contributors = topUsers.slice(0, 5);
        const contributorData = contributors.map(u => (u.total_accepted || 0) + (u.total_rejected || 0));
        const contributorLabels = contributors.map(u => u.full_name.split(' ')[0]);

        const chartContributors = new Chart(contributorsCtx, {
            type: 'pie',
            data: {
                labels: contributorLabels,
                datasets: [{
                    data: contributorData,
                    backgroundColor: chartColors.background.slice(0, contributors.length),
                    borderWidth: 2,
                    borderColor: isDarkMode ? '#1a1a1a' : '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'right',
                        labels: {
                            usePointStyle: true,
                            padding: 10,
                            font: { size: 11 },
                            boxWidth: 10,
                            color: textColor
                        }
                    }
                }
            }
        });

        // 6. Transcription Overview (Doughnut Chart)
        var transCtx = document.getElementById('transChart').getContext('2d');
        const chartTrans = new Chart(transCtx, {
            type: 'doughnut',
            data: {
                labels: ['Qabul qilingan', 'Rad etilgan', 'Kutilmoqda'],
                datasets: [{
                    data: [<%= stats.transAccepted %>, <%= stats.transRejected %>, <%= stats.transcriptionPending %>],
                    backgroundColor: [chartColors.success, chartColors.error, chartColors.warning],
                    borderWidth: 2,
                    borderColor: isDarkMode ? '#1a1a1a' : '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'right',
                        labels: {
                            usePointStyle: true,
                            padding: 10,
                            font: { size: 11 },
                            boxWidth: 10,
                            color: textColor
                        }
                    }
                }
            }
        });

        // 7. Transcription Contributors (Bar Chart)
        var transContributorsCtx = document.getElementById('transContributorsChart').getContext('2d');
        var transStatsData = <% - JSON.stringify(transStats || []).replace(/</g, '\\u003c') %>;
        var transUsers = transStatsData.filter(function (u) { return u.accepted_count > 0; }).slice(0, 10);
        const chartTransContributors = new Chart(transContributorsCtx, {
            type: 'bar',
            data: {
                labels: transUsers.map(function (u) { return u.full_name ? u.full_name.split(' ')[0] : 'N/A'; }),
                datasets: [{
                    label: 'Qabul qilingan',
                    data: transUsers.map(function (u) { return u.accepted_count || 0; }),
                    backgroundColor: chartColors.success,
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                indexAxis: 'y',
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: {
                        grid: { color: gridColor },
                        ticks: { color: textColor }
                    },
                    y: {
                        grid: { display: false },
                        ticks: { color: textColor, font: { size: 11 } }
                    }
                }
            }
        });

        // 8. Xorazm Dialect Chart (Doughnut)
        var xorazmCtx = document.getElementById('xorazmChart').getContext('2d');
        const chartXorazm = new Chart(xorazmCtx, {
            type: 'doughnut',
            data: {
                labels: ['Qabul qilingan', 'Rad etilgan', 'Kutilmoqda'],
                datasets: [{
                    data: [<%= stats.xorazmAccepted %>, <%= stats.xorazmRejected %>, <%= stats.xorazmPending %>],
                    backgroundColor: [chartColors.success, chartColors.error, chartColors.warning],
                    borderWidth: 2,
                    borderColor: isDarkMode ? '#1a1a1a' : '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { color: textColor, padding: 15, font: { size: 11 } }
                    }
                }
            }
        });

        // 10. Podcast Doughnut Chart
        var podcastCtx = document.getElementById('podcastChart').getContext('2d');
        const chartPodcast = new Chart(podcastCtx, {
            type: 'doughnut',
            data: {
                labels: ['Qabul', 'Rad', 'Kutilmoqda'],
                datasets: [{
                    data: [<%= stats.podcastAccepted %>, <%= stats.podcastRejected %>, <%= stats.podcastPending %>],
                    backgroundColor: ['#22c55e', '#ef4444', '#94a3b8'],
                    borderWidth: 0
                }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
        });

        // 11. Podcast User Activity Chart (Horizontal Bar)
        var podcastUserCtx = document.getElementById('podcastUserChart').getContext('2d');
        var podcastUsers = userData.filter(function (u) { return (u.podcast_24h || 0) > 0 || (u.podcast_7d || 0) > 0; })
            .sort(function (a, b) { return (b.podcast_7d || 0) - (a.podcast_7d || 0); })
            .slice(0, 10);
        const chartPodcastUser = new Chart(podcastUserCtx, {
            type: 'bar',
            data: {
                labels: podcastUsers.map(function (u) { return u.full_name ? u.full_name.split(' ')[0] : 'N/A'; }),
                datasets: [
                    { label: '24 soat', data: podcastUsers.map(function (u) { return u.podcast_24h || 0; }), backgroundColor: '#8b5cf6' },
                    { label: '7 kun', data: podcastUsers.map(function (u) { return u.podcast_7d || 0; }), backgroundColor: '#c4b5fd' }
                ]
            },
            options: { responsive: true, maintainAspectRatio: false, indexAxis: 'y', plugins: { legend: { position: 'bottom' } } }
        });

        // 9. Xorazm User Activity Chart (Horizontal Bar)
        var xorazmUserCtx = document.getElementById('xorazmUserChart').getContext('2d');
        var xorazmUsers = userData.filter(function (u) { return (u.xorazm_24h || 0) > 0 || (u.xorazm_7d || 0) > 0; })
            .sort(function (a, b) { return (b.xorazm_7d || 0) - (a.xorazm_7d || 0); })
            .slice(0, 8);

        const chartXorazmUser = new Chart(xorazmUserCtx, {
            type: 'bar',
            data: {
                labels: xorazmUsers.map(function (u) { return u.full_name ? u.full_name.split(' ')[0] : 'N/A'; }),
                datasets: [
                    {
                        label: '24 soat',
                        data: xorazmUsers.map(function (u) { return u.xorazm_24h || 0; }),
                        backgroundColor: chartColors.primary,
                        borderRadius: 4
                    },
                    {
                        label: '7 kun',
                        data: xorazmUsers.map(function (u) { return u.xorazm_7d || 0; }),
                        backgroundColor: chartColors.success,
                        borderRadius: 4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                indexAxis: 'y',
                plugins: {
                    legend: {
                        position: 'top',
                        labels: { color: textColor, padding: 15, font: { size: 11 } }
                    }
                },
                scales: {
                    x: {
                        stacked: false,
                        grid: { color: gridColor },
                        ticks: { color: textColor }
                    },
                    y: {
                        grid: { display: false },
                        ticks: { color: textColor, font: { size: 11 } }
                    }
                }
            }
        });
        // ========== LIVE AUTO-REFRESH ==========
        async function updateDashboard() {
            try {
                const res = await fetch('/api/dashboard');
                if (!res.ok) return;
                const data = await res.json();
                if (!data.success) return;

                const s = data.stats;

                // Update stat cards
                document.getElementById('stat-total-checked').textContent = s.totalChecked.toLocaleString();
                document.getElementById('stat-accepted').textContent = s.totalAccepted.toLocaleString();
                document.getElementById('stat-accepted-sub').textContent = s.acceptedDuration;
                document.getElementById('stat-rejected').textContent = s.totalRejected.toLocaleString();
                document.getElementById('stat-rejected-sub').textContent = s.rejectedDuration;
                document.getElementById('stat-pending').textContent = s.pending.toLocaleString();
                document.getElementById('stat-pending-sub').textContent = s.pendingDuration;

                // Update transcription/xorazm subtitles
                document.getElementById('trans-subtitle').textContent =
                    'Qabul qilingan: ' + s.transAccepted + ' | Kutilmoqda: ' + s.transcriptionPending;
                document.getElementById('xorazm-subtitle').textContent =
                    'Qabul qilingan: ' + s.xorazmAccepted + ' | Kutilmoqda: ' + s.xorazmPending;
                document.getElementById('podcast-subtitle').textContent =
                    'Qabul qilingan: ' + (s.podcastAccepted || 0) + ' | Kutilmoqda: ' + (s.podcastPending || 0);

                // Update Chart 1: Overall Statistics (Bar)
                chartStats.data.datasets[0].data = [
                    s.pending || 0, s.transcriptionPending || 0, s.totalAccepted || 0, s.totalRejected || 0
                ];
                chartStats.update();

                // Update Chart 2: User Activity (Horizontal Bar)
                var freshUsers = (data.users || []).slice(0, 8)
                    .sort(function (a, b) { return (b.total_accepted + b.total_rejected) - (a.total_accepted + a.total_rejected); });
                chartUserActivity.data.labels = freshUsers.map(function (u) { return u.full_name.split(' ')[0]; });
                chartUserActivity.data.datasets[0].data = freshUsers.map(function (u) { return u.total_accepted || 0; });
                chartUserActivity.data.datasets[1].data = freshUsers.map(function (u) { return u.total_rejected || 0; });
                chartUserActivity.update();

                // Update Chart 3: Timeline (Line)
                var freshTimeline = data.lifetimeStats || [];
                chartTimeline.data.labels = freshTimeline.map(function (d) {
                    var dt = new Date(d.date || d.day);
                    return dt.toLocaleDateString('uz-UZ', { weekday: 'short', day: 'numeric' });
                });
                chartTimeline.data.datasets[0].data = freshTimeline.map(function (d) { return d.accepted || 0; });
                chartTimeline.data.datasets[1].data = freshTimeline.map(function (d) { return d.rejected || 0; });
                chartTimeline.update();

                // Update Chart 4: Accept/Reject Ratio (Doughnut)
                chartRatio.data.datasets[0].data = [s.totalAccepted || 0, s.totalRejected || 0];
                chartRatio.update();

                // Update Chart 5: Top Contributors (Pie)
                var freshContributors = freshUsers.slice(0, 5);
                chartContributors.data.labels = freshContributors.map(function (u) { return u.full_name.split(' ')[0]; });
                chartContributors.data.datasets[0].data = freshContributors.map(function (u) { return (u.total_accepted || 0) + (u.total_rejected || 0); });
                chartContributors.update();

                // Update Chart 6: Transcription (Doughnut)
                chartTrans.data.datasets[0].data = [s.transAccepted || 0, s.transRejected || 0, s.transcriptionPending || 0];
                chartTrans.update();

                // Update Chart 7: Trans Contributors (Bar)
                var freshTransUsers = (data.transStats || []).filter(function (u) { return u.accepted_count > 0; }).slice(0, 10);
                chartTransContributors.data.labels = freshTransUsers.map(function (u) { return u.full_name ? u.full_name.split(' ')[0] : 'N/A'; });
                chartTransContributors.data.datasets[0].data = freshTransUsers.map(function (u) { return u.accepted_count || 0; });
                chartTransContributors.update();

                // Update Chart 8: Xorazm (Doughnut)
                chartXorazm.data.datasets[0].data = [s.xorazmAccepted || 0, s.xorazmRejected || 0, s.xorazmPending || 0];
                chartXorazm.update();

                // Update Chart 10: Podcast (Doughnut)
                chartPodcast.data.datasets[0].data = [s.podcastAccepted || 0, s.podcastRejected || 0, s.podcastPending || 0];
                chartPodcast.update();

                // Update Chart 11: Podcast User Activity
                var freshPodcastUsers = (data.users || []).filter(function (u) { return (u.podcast_24h || 0) > 0 || (u.podcast_7d || 0) > 0; })
                    .sort(function (a, b) { return (b.podcast_7d || 0) - (a.podcast_7d || 0); }).slice(0, 10);
                chartPodcastUser.data.labels = freshPodcastUsers.map(function (u) { return u.full_name ? u.full_name.split(' ')[0] : 'N/A'; });
                chartPodcastUser.data.datasets[0].data = freshPodcastUsers.map(function (u) { return u.podcast_24h || 0; });
                chartPodcastUser.data.datasets[1].data = freshPodcastUsers.map(function (u) { return u.podcast_7d || 0; });
                chartPodcastUser.update();

                // Update Chart 9: Xorazm User Activity
                var freshXorazmUsers = (data.users || []).filter(function (u) { return (u.xorazm_24h || 0) > 0 || (u.xorazm_7d || 0) > 0; })
                    .sort(function (a, b) { return (b.xorazm_7d || 0) - (a.xorazm_7d || 0); })
                    .slice(0, 8);
                chartXorazmUser.data.labels = freshXorazmUsers.map(function (u) { return u.full_name ? u.full_name.split(' ')[0] : 'N/A'; });
                chartXorazmUser.data.datasets[0].data = freshXorazmUsers.map(function (u) { return u.xorazm_24h || 0; });
                chartXorazmUser.data.datasets[1].data = freshXorazmUsers.map(function (u) { return u.xorazm_7d || 0; });
                chartXorazmUser.update();

            } catch (err) {
                console.error('Dashboard refresh error:', err);
            }
        }

        // Auto-refresh every 10 seconds
        setInterval(updateDashboard, 10000);
    </script>

</body>

</html>