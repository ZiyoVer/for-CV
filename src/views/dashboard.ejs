<!DOCTYPE html>
<html lang="uz">

<head>
    <!-- Premium UI v2.0 -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>STT Admin - Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        :root {
            --bg: #ffffff;
            --navbar-bg: #fafafa;
            --card-bg: #fafafa;
            --text: #0a0a0a;
            --text-muted: #737373;
            --border: #e5e5e5;
            --border-light: #f5f5f5;
            --input-bg: #fafafa;
            --btn-ghost: #f5f5f5;
            --shadow: rgba(0, 0, 0, 0.05);
        }

        [data-theme="dark"] {
            --bg: #0a0a0a;
            --navbar-bg: #111111;
            --card-bg: #111111;
            --text: #ffffff;
            --text-muted: #a3a3a3;
            --border: #262626;
            --border-light: #171717;
            --input-bg: #171717;
            --btn-ghost: #171717;
            --shadow: rgba(0, 0, 0, 0.4);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg);
            min-height: 100vh;
            color: var(--text);
            transition: background 0.3s, color 0.3s;
        }

        .navbar {
            background: var(--navbar-bg);
            border-bottom: 1px solid var(--border);
            padding: 16px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(10px);
        }

        .logo {
            font-size: 16px;
            font-weight: 700;
            color: #0a0a0a;
            letter-spacing: -0.5px;
        }

        .logout-btn {
            color: #737373;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: color 0.2s;
        }

        .logout-btn:hover {
            color: #0a0a0a;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 48px 32px;
        }

        .section-title {
            font-size: 18px;
            font-weight: 700;
            color: #0a0a0a;
            margin-bottom: 8px;
            letter-spacing: -0.3px;
        }

        .section-desc {
            font-size: 14px;
            color: #737373;
            margin-bottom: 32px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 48px;
        }

        .stat-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 24px;
            transition: all 0.2s;
        }

        .stat-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .stat-card:hover {
            box-shadow: 0 4px 12px var(--shadow);
            transform: translateY(-2px);
        }

        .stat-label {
            font-size: 13px;
            color: var(--text-muted);
            font-weight: 500;
        }

        .stat-value {
            font-size: 32px;
            font-weight: 700;
            color: var(--text);
        }

        /* Charts Grid */
        .charts-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 24px;
            margin-bottom: 24px;
        }

        .chart-section {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 24px;
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

        .chart-title {
            font-size: 16px;
            font-weight: 600;
            color: var(--text);
            display: flex;
            align-items: center;
        }

        .chart-subtitle {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        .table-container {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 48px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background: var(--navbar-bg);
            color: var(--text-muted);
            font-weight: 600;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 1px solid var(--border);
        }

        tr {
            background: transparent;
            border-bottom: 1px solid var(--border-light);
            transition: background 0.15s;
        }

        tr:hover {
            background: var(--border-light);
        }

        td {
            color: var(--text);
        }

        .modal {
            background: var(--bg);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 32px;
            width: 100%;
            max-width: 440px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
        }

        .form-group input {
            background: var(--input-bg);
            border: 1px solid var(--border);
            color: var(--text);
        }

        .form-group input:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
        }

        .upload-section {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 32px;
            margin-bottom: 48px;
        }

        @media (max-width: 1000px) {
            .charts-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
    <nav class="navbar">
        <div class="logo">STT Admin</div>
        <div style="display: flex; gap: 20px; align-items: center;">
            <button onclick="toggleTheme()" class="btn-ghost" id="themeToggle"
                style="border: none; background: none; cursor: pointer; color: var(--text-muted); padding: 8px; border-radius: 8px;">
                <i data-lucide="sun" id="sunIcon"></i>
                <i data-lucide="moon" id="moonIcon" style="display: none;"></i>
            </button>
            <a href="/logout" class="logout-btn">Chiqish <i data-lucide="log-out"
                    style="width: 14px; height: 14px; margin-left: 4px;"></i></a>
        </div>
    </nav>

    <div class="container">
        <h2 class="section-title">Dashboard</h2>
        <p class="section-desc">STT Tekshiruv tizimi umumiy statistikasi</p>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-label">Jami Tekshirilgan</div>
                    <i data-lucide="activity" class="text-muted"></i>
                </div>
                <div class="stat-value">
                    <%= stats.totalChecked %>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-label">Qabul Qilingan</div>
                    <i data-lucide="check-circle" style="color: #16a34a;"></i>
                </div>
                <div class="stat-value green">
                    <%= stats.totalAccepted %>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-label">Rad Etilgan</div>
                    <i data-lucide="x-circle" style="color: #dc2626;"></i>
                </div>
                <div class="stat-value red">
                    <%= stats.totalRejected %>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-label">Kutilmoqda</div>
                    <i data-lucide="clock" style="color: #ca8a04;"></i>
                </div>
                <div class="stat-value yellow">
                    <%= stats.pending %>
                </div>
            </div>
            <!-- New Duration Stats -->
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-label">Tekshirilgan Audio</div>
                    <i data-lucide="headphones"></i>
                </div>
                <div class="stat-value" style="font-size: 24px;">
                    <%= stats.checkedDuration %>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-label">Kutilayotgan Audio</div>
                    <i data-lucide="timer" style="color: #ca8a04;"></i>
                </div>
                <div class="stat-value yellow" style="font-size: 24px;">
                    <%= stats.pendingDuration %>
                </div>
            </div>
        </div>

        <!-- 24-Hour Statistics Chart -->
        <div class="charts-grid">
            <div class="chart-section">
                <div class="chart-header">
                    <div>
                        <div class="chart-title"><i data-lucide="bar-chart-3"
                                style="width: 16px; margin-right: 8px;"></i> 24 Soatlik Statistika</div>
                        <div class="chart-subtitle">Soatlar bo'yicha tekshiruvlar hajmi</div>
                    </div>
                </div>
                <div class="chart-container">
                    <canvas id="hourlyChart"></canvas>
                </div>
            </div>

            <!-- New Lifetime Stats Chart -->
            <div class="chart-section">
                <div class="chart-header">
                    <div>
                        <div class="chart-title"><i data-lucide="pie-chart" style="width: 16px; margin-right: 8px;"></i>
                            Umumiy Ulushlar</div>
                        <div class="chart-subtitle">Qabul qilingan vs Rad etilgan</div>
                    </div>
                </div>
                <div class="chart-container" style="height: 300px;">
                    <canvas id="lifetimePieChart"></canvas>
                </div>
            </div>
        </div>

        <!-- 30-Day Growth Chart -->
        <div class="chart-section" style="margin-bottom: 48px;">
            <div class="chart-header">
                <div>
                    <div class="chart-title"><i data-lucide="trending-up" style="width: 16px; margin-right: 8px;"></i>
                        30 Kunlik O'sish</div>
                    <div class="chart-subtitle">Kunlik tasdiqlangan audiolar tarixi</div>
                </div>
            </div>
            <div class="chart-container">
                <canvas id="lifetimeChart"></canvas>
            </div>
        </div>

        <div class="feature-list">
            <div class="feature-item">
                <div class="feature-icon">✓</div>
                <span><strong>Annotatorlar</strong> Audio va matnlarni tekshiruvchi jamoangiz</span>
            </div>
            <div class="feature-item">
                <div class="feature-icon">✓</div>
                <span><strong>20 bepul</strong> Har 24 soatda birinchi 20 tekshiruv bepul</span>
            </div>
            <div class="feature-item">
                <div class="feature-icon">✓</div>
                <span><strong>30 so'm</strong> Keyingi har bir tekshiruv uchun to'lov</span>
            </div>
        </div>

        <!-- Transcription Upload Section -->
        <div class="upload-section">
            <h2 class="section-title">📝 Transkripsiya</h2>
            <p class="section-desc" style="margin-bottom: 16px;">Audio fayllarni transkripsiya uchun yuklang</p>

            <form method="POST" action="/transcription/upload" enctype="multipart/form-data" id="uploadForm">
                <div style="display: flex; gap: 16px; align-items: center; flex-wrap: wrap;">
                    <input type="file" name="audioFiles" multiple accept="audio/*" onchange="updateFileCount(this)">
                    <button type="submit" class="btn" id="uploadBtn">
                        <i data-lucide="upload" style="width: 16px; height: 16px; margin-right: 4px;"></i> Yuklash
                    </button>
                </div>
                <p id="fileCount" style="color: #737373; font-size: 13px; margin-top: 12px;"></p>
            </form>

            <% if (typeof stats.transcriptionPending !=='undefined' ) { %>
                <p style="color: #525252; font-size: 13px; margin-top: 16px;">
                    ⏳ Kutilmoqda: <span style="color: #ca8a04; font-weight: 600;">
                        <%= stats.transcriptionPending %>
                    </span> ta transkripsiya
                </p>
                <% } %>
        </div>

        <div class="users-header">
            <h2 class="section-title">Foydalanuvchilar</h2>
            <button class="btn" onclick="openModal()">
                <i data-lucide="plus" style="width: 16px; height: 16px; margin-right: 4px;"></i> Yangi Qo'shish
            </button>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Ism</th>
                        <th>Bugun</th>
                        <th>Jami ✓</th>
                        <th>Jami ✗</th>
                        <th>Balans</th>
                        <th>Amallar</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(user=> { %>
                        <tr>
                            <td><code><%= user.telegram_id %></code></td>
                            <td>
                                <%= user.full_name %>
                                    <% if (user.is_admin) { %><span class="admin-badge">ADMIN</span>
                                        <% } %>
                            </td>
                            <td>
                                <%= user.checks_today %>
                            </td>
                            <td>
                                <%= user.total_accepted %>
                            </td>
                            <td>
                                <%= user.total_rejected %>
                            </td>
                            <td class="balance">
                                <%= user.balance || 0 %> so'm
                            </td>
                            <td class="actions">
                                <a href="/review/<%= user.telegram_id %>" class="btn btn-outline btn-sm">
                                    <i data-lucide="shield-check"
                                        style="width: 14px; height: 14px; margin-right: 4px;"></i> Tekshirish
                                </a>
                                <button class="btn btn-warning btn-sm" data-id="<%= user.telegram_id %>"
                                    data-name="<%= user.full_name %>" onclick="handleBalanceModal(this)">
                                    <i data-lucide="plus-square"
                                        style="width: 14px; height: 14px; margin-right: 4px;"></i> Balans
                                </button>

                                <form method="POST" action="/users/payout/<%= user.telegram_id %>"
                                    style="display:inline;"
                                    onsubmit="return confirm('To\'lov yakunlandimi? Balans nolga tushiriladi.')">
                                    <button type="submit" class="btn btn-success btn-sm">
                                        <i data-lucide="banknote"
                                            style="width: 14px; height: 14px; margin-right: 4px;"></i> To'lash
                                    </button>
                                </form>

                                <button class="btn btn-outline btn-sm" data-id="<%= user.telegram_id %>"
                                    data-name="<%= user.full_name %>" data-admin="<%= user.is_admin %>"
                                    onclick="handleEditModal(this)">
                                    <i data-lucide="edit" style="width: 14px; height: 14px; margin-right: 4px;"></i>
                                    Tahrirlash
                                </button>

                                <form method="POST" action="/users/delete/<%= user.telegram_id %>"
                                    style="display:inline;"
                                    onsubmit="return confirm('Foydalanuvchini o\'chirishni tasdiqlaysizmi?')">
                                    <button type="submit" class="btn btn-sm" style="background: #dc2626; color: #fff;">
                                        <i data-lucide="trash-2"
                                            style="width: 14px; height: 14px; margin-right: 4px;"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Add User Modal -->
    <div class="modal-overlay" id="addUserModal">
        <div class="modal">
            <h3>Yangi Foydalanuvchi</h3>
            <form method="POST" action="/users/add">
                <div class="form-group">
                    <label>Telegram ID</label>
                    <input type="number" name="telegram_id" placeholder="123456789" required>
                </div>
                <div class="form-group">
                    <label>To'liq Ism</label>
                    <input type="text" name="full_name" placeholder="Ism Familiya" required>
                </div>
                <div class="form-group">
                    <div class="checkbox-group">
                        <input type="checkbox" name="is_admin" id="is_admin">
                        <label for="is_admin" style="margin: 0;">Admin qilish</label>
                    </div>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-outline" onclick="closeModal()">Bekor</button>
                    <button type="submit" class="btn">Qo'shish →</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Add Balance Modal -->
    <div class="modal-overlay" id="balanceModal">
        <div class="modal">
            <h3>Balans Qo'shish</h3>
            <p style="color: #525252; font-size: 14px; margin-bottom: 20px;">Foydalanuvchi: <span id="balanceUserName"
                    style="color: #0a0a0a; font-weight: 600;"></span></p>
            <form method="POST" id="balanceForm">
                <div class="form-group">
                    <label>Qo'shiladigan summa (so'm)</label>
                    <input type="number" name="amount" placeholder="3150" required>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-outline" onclick="closeBalanceModal()">Bekor</button>
                    <button type="submit" class="btn">Qo'shish →</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Edit User Modal -->
    <div class="modal-overlay" id="editUserModal">
        <div class="modal">
            <h3>Foydalanuvchini Tahrirlash</h3>
            <form method="POST" id="editUserForm">
                <div class="form-group">
                    <label>Telegram ID</label>
                    <input type="number" name="telegram_id" id="editTelegramId" placeholder="123456789" required>
                </div>
                <div class="form-group">
                    <label>To'liq Ism</label>
                    <input type="text" name="full_name" id="editFullName" placeholder="Ism Familiya" required>
                </div>
                <div class="form-group">
                    <div class="checkbox-group">
                        <input type="checkbox" name="is_admin" id="editIsAdmin">
                        <label for="editIsAdmin" style="margin: 0;">Admin qilish</label>
                    </div>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-outline" onclick="closeEditModal()">Bekor</button>
                    <button type="submit" class="btn">Saqlash →</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Lucide icons initialization
        lucide.createIcons();

        // Theme management
        const theme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', theme);
        updateThemeIcons(theme);

        function toggleTheme() {
            const currentTheme = document.documentElement.getAttribute('data-theme');
            const newTheme = currentTheme === 'light' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', newTheme);
            localStorage.setItem('theme', newTheme);
            updateThemeIcons(newTheme);

            // Refresh charts colors if they exist
            if (hourlyChart) loadHourlyStats();
            if (lifetimeChart) loadLifetimeStats();
        }

        function updateThemeIcons(theme) {
            document.getElementById('sunIcon').style.display = theme === 'light' ? 'none' : 'block';
            document.getElementById('moonIcon').style.display = theme === 'light' ? 'block' : 'none';
        }
        function openModal() {
            document.getElementById('addUserModal').classList.add('active');
        }
        function closeModal() {
            document.getElementById('addUserModal').classList.remove('active');
        }
        document.getElementById('addUserModal').addEventListener('click', (e) => {
            if (e.target.classList.contains('modal-overlay')) closeModal();
        });

        function handleBalanceModal(btn) {
            const userId = btn.getAttribute('data-id');
            const userName = btn.getAttribute('data-name');
            openBalanceModal(userId, userName);
        }

        function openBalanceModal(userId, userName) {
            document.getElementById('balanceUserName').textContent = userName;
            document.getElementById('balanceForm').action = '/users/add-balance/' + userId;
            document.getElementById('balanceModal').classList.add('active');
        }
        function closeBalanceModal() {
            document.getElementById('balanceModal').classList.remove('active');
        }
        document.getElementById('balanceModal').addEventListener('click', (e) => {
            if (e.target.classList.contains('modal-overlay')) closeBalanceModal();
        });

        function handleEditModal(btn) {
            const id = btn.getAttribute('data-id');
            const name = btn.getAttribute('data-name');
            const isAdmin = btn.getAttribute('data-admin') === 'true';
            openEditModal(id, name, isAdmin);
        }

        function openEditModal(telegramId, fullName, isAdmin) {
            document.getElementById('editTelegramId').value = telegramId;
            document.getElementById('editFullName').value = fullName;
            document.getElementById('editIsAdmin').checked = isAdmin;
            document.getElementById('editUserForm').action = '/users/update/' + telegramId;
            document.getElementById('editUserModal').classList.add('active');
        }
        function closeEditModal() {
            document.getElementById('editUserModal').classList.remove('active');
        }
        document.getElementById('editUserModal').addEventListener('click', (e) => {
            if (e.target.classList.contains('modal-overlay')) closeEditModal();
        });

        // Transcription upload
        function updateFileCount(input) {
            const count = input.files.length;
            document.getElementById('fileCount').textContent = count > 0 ? `${count} ta fayl tanlandi` : '';
        }

        document.getElementById('uploadForm').addEventListener('submit', function () {
            document.getElementById('uploadBtn').textContent = '⏳ Yuklanmoqda...';
            document.getElementById('uploadBtn').disabled = true;
        });

        // Chart.js Theme Helpers
        function getChartColors() {
            const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            return {
                grid: isDark ? '#262626' : '#f5f5f5',
                text: isDark ? '#a3a3a3' : '#737373',
                bg: isDark ? '#111111' : '#ffffff'
            };
        }

        // 24-Hour Statistics Chart
        let hourlyChart = null;

        async function loadHourlyStats() {
            try {
                const response = await fetch('/api/hourly-stats');
                const data = await response.json();

                if (data.success) {
                    const ctx = document.getElementById('hourlyChart').getContext('2d');
                    const colors = getChartColors();

                    // Format labels to show hours
                    const formattedLabels = data.labels.map(label => {
                        const date = new Date(label);
                        return date.toLocaleTimeString('uz-UZ', { hour: '2-digit', minute: '2-digit' });
                    });

                    if (hourlyChart) hourlyChart.destroy();

                    hourlyChart = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: formattedLabels,
                            datasets: data.datasets
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    position: 'top',
                                    labels: {
                                        font: { family: 'Inter', size: 12 },
                                        color: colors.text,
                                        usePointStyle: true,
                                        padding: 20
                                    }
                                },
                                tooltip: {
                                    backgroundColor: '#0a0a0a',
                                    padding: 12,
                                    cornerRadius: 8
                                }
                            },
                            scales: {
                                x: {
                                    grid: { color: colors.grid },
                                    ticks: { font: { family: 'Inter', size: 11 }, color: colors.text }
                                },
                                y: {
                                    beginAtZero: true,
                                    grid: { color: colors.grid },
                                    ticks: { font: { family: 'Inter', size: 11 }, color: colors.text }
                                }
                            },
                            interaction: {
                                intersect: false,
                                mode: 'index'
                            }
                        }
                    });
                }
            } catch (err) { console.error(err); }
        }

        // Lifetime Statistics Chart
        let lifetimeChart = null;
        let lifetimePieChart = null;

        async function loadLifetimeStats() {
            try {
                const response = await fetch('/api/lifetime-stats');
                const data = await response.json();

                if (data.success) {
                    const colors = getChartColors();

                    // 1. Growth Area Chart
                    const ctxArea = document.getElementById('lifetimeChart').getContext('2d');
                    const labels = data.stats.map(s => {
                        const d = new Date(s.day);
                        return d.toLocaleDateString('uz-UZ', { month: 'short', day: 'numeric' });
                    });

                    if (lifetimeChart) lifetimeChart.destroy();

                    lifetimeChart = new Chart(ctxArea, {
                        type: 'line',
                        data: {
                            labels: labels,
                            datasets: [
                                {
                                    label: 'Qabul qilindi',
                                    data: data.stats.map(s => s.accepted),
                                    borderColor: '#16a34a',
                                    backgroundColor: '#16a34a20',
                                    fill: true,
                                    tension: 0.4
                                },
                                {
                                    label: 'Rad etildi',
                                    data: data.stats.map(s => s.rejected),
                                    borderColor: '#dc2626',
                                    backgroundColor: '#dc262620',
                                    fill: true,
                                    tension: 0.4
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { labels: { color: colors.text, font: { family: 'Inter' } } }
                            },
                            scales: {
                                x: { grid: { color: colors.grid }, ticks: { color: colors.text } },
                                y: { grid: { color: colors.grid }, ticks: { color: colors.text } }
                            }
                        }
                    });

                    // 2. Pie Chart (Distribution)
                    const ctxPie = document.getElementById('lifetimePieChart').getContext('2d');
                    const totalAccepted = data.stats.reduce((a, b) => a + b.accepted, 0);
                    const totalRejected = data.stats.reduce((a, b) => a + b.rejected, 0);

                    if (lifetimePieChart) lifetimePieChart.destroy();

                    lifetimePieChart = new Chart(ctxPie, {
                        type: 'doughnut',
                        data: {
                            labels: ['Qabul', 'Rad'],
                            datasets: [{
                                data: [totalAccepted, totalRejected],
                                backgroundColor: ['#16a34a', '#dc2626'],
                                borderWidth: 0,
                                hoverOffset: 4
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            cutout: '70%',
                            plugins: {
                                legend: {
                                    position: 'bottom',
                                    labels: { color: colors.text, font: { family: 'Inter' }, padding: 20 }
                                }
                            }
                        }
                    });
                }
            } catch (err) { console.error(err); }
        }

        // Initialize all stats
        loadHourlyStats();
        loadLifetimeStats();

        // Refresh periodically (every 1 min)
        setInterval(() => {
            loadHourlyStats();
            loadLifetimeStats();
        }, 60000);
    </script>
</body>

</html>