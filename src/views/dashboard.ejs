<!DOCTYPE html>
<html lang="uz">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>STT Dashboard</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --bg-page: #FAF9F6;
            --bg-card: #FFFFFF;
            --bg-hover: #F5F3EF;
            --bg-subtle: #F0EDE6;
            --bg-input: #F7F5F0;
            --text-primary: #1A1714;
            --text-secondary: #6B6560;
            --text-tertiary: #9C9590;
            --border: #E8E4DD;
            --border-subtle: #F0EDE6;
            --accent: #C96442;
            --accent-hover: #B85A3B;
            --accent-light: rgba(201, 100, 66, 0.08);
            --accent-medium: rgba(201, 100, 66, 0.15);
            --success: #2D8A56;
            --success-light: rgba(45, 138, 86, 0.08);
            --error: #C4442A;
            --error-light: rgba(196, 68, 42, 0.08);
            --gold: #B8860B;
            --gold-bg: linear-gradient(135deg, #FDF6E3 0%, #FAF0D4 100%);
            --gold-border: #E8D5A0;
            --silver: #71717A;
            --silver-bg: linear-gradient(135deg, #F7F7F8 0%, #EDEDF0 100%);
            --silver-border: #D4D4D8;
            --bronze: #A0522D;
            --bronze-bg: linear-gradient(135deg, #FBF3ED 0%, #F5E8DC 100%);
            --bronze-border: #DFC4A8;
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 16px;
            --radius-xl: 20px;
            --shadow-sm: 0 1px 2px rgba(26, 23, 20, 0.04);
            --shadow-md: 0 2px 8px rgba(26, 23, 20, 0.06), 0 1px 2px rgba(26, 23, 20, 0.04);
            --shadow-lg: 0 8px 24px rgba(26, 23, 20, 0.08), 0 2px 8px rgba(26, 23, 20, 0.04);
            --transition: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        [data-theme="dark"] {
            --bg-page: #161412;
            --bg-card: #1E1C19;
            --bg-hover: #262420;
            --bg-subtle: #222019;
            --bg-input: #1A1816;
            --text-primary: #F0EDE6;
            --text-secondary: #9C9590;
            --text-tertiary: #6B6560;
            --border: #2E2B26;
            --border-subtle: #262420;
            --accent: #D97757;
            --accent-hover: #E08868;
            --accent-light: rgba(217, 119, 87, 0.1);
            --accent-medium: rgba(217, 119, 87, 0.18);
            --success: #4ADE80;
            --success-light: rgba(74, 222, 128, 0.1);
            --error: #F87171;
            --error-light: rgba(248, 113, 113, 0.1);
            --gold: #FACC15;
            --gold-bg: linear-gradient(135deg, #292518 0%, #2E2810 100%);
            --gold-border: #4A3F1A;
            --silver: #A1A1AA;
            --silver-bg: linear-gradient(135deg, #222222 0%, #262626 100%);
            --silver-border: #3F3F46;
            --bronze: #D97757;
            --bronze-bg: linear-gradient(135deg, #261C16 0%, #2A1E14 100%);
            --bronze-border: #4A3020;
            --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.2);
            --shadow-md: 0 2px 8px rgba(0, 0, 0, 0.25), 0 1px 2px rgba(0, 0, 0, 0.15);
            --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.3), 0 2px 8px rgba(0, 0, 0, 0.2);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
            background: var(--bg-page);
            color: var(--text-primary);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* ─── Navbar ─── */
        .navbar {
            background: var(--bg-card);
            border-bottom: 1px solid var(--border);
            padding: 0 24px;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        .nav-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .nav-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 15px;
            font-weight: 600;
            color: var(--text-primary);
            letter-spacing: -0.3px;
        }

        .nav-logo svg {
            width: 22px;
            height: 22px;
            color: var(--accent);
        }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .live-badge {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: var(--success);
            background: var(--success-light);
            padding: 5px 10px;
            border-radius: 100px;
        }

        .live-dot {
            width: 6px;
            height: 6px;
            background: var(--success);
            border-radius: 50%;
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.4;
            }
        }

        .theme-btn {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border);
            background: var(--bg-card);
            color: var(--text-secondary);
            cursor: pointer;
            font-size: 16px;
            transition: all var(--transition);
        }

        .theme-btn:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
        }

        /* ─── Container ─── */
        .container {
            max-width: 720px;
            margin: 0 auto;
            padding: 48px 20px 64px;
        }

        /* ─── Header ─── */
        .header {
            text-align: center;
            margin-bottom: 40px;
        }

        .header-title {
            font-size: 26px;
            font-weight: 650;
            color: var(--text-primary);
            letter-spacing: -0.5px;
            margin-bottom: 6px;
        }

        .header-subtitle {
            font-size: 14px;
            color: var(--text-secondary);
            font-weight: 400;
        }

        .update-info {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin-top: 16px;
            font-size: 12px;
            color: var(--text-tertiary);
            background: var(--bg-subtle);
            padding: 5px 12px;
            border-radius: 100px;
        }

        .update-info svg {
            width: 12px;
            height: 12px;
            opacity: 0.7;
        }

        /* ─── Podium ─── */
        .podium {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 12px;
            margin-bottom: 32px;
        }

        .podium-card {
            position: relative;
            border-radius: var(--radius-lg);
            padding: 28px 16px 24px;
            text-align: center;
            transition: transform var(--transition), box-shadow var(--transition);
            border: 1px solid var(--border);
            overflow: hidden;
        }

        .podium-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-lg);
        }

        .podium-card.gold {
            background: var(--gold-bg);
            border-color: var(--gold-border);
            order: 2;
        }

        .podium-card.silver {
            background: var(--silver-bg);
            border-color: var(--silver-border);
            order: 1;
        }

        .podium-card.bronze {
            background: var(--bronze-bg);
            border-color: var(--bronze-border);
            order: 3;
        }

        .podium-medal {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 14px;
            font-size: 20px;
            font-weight: 700;
        }

        .podium-card.gold .podium-medal {
            background: linear-gradient(135deg, #F5D76E, #D4A017);
            color: #5C3D0A;
            box-shadow: 0 2px 12px rgba(212, 160, 23, 0.3);
        }

        .podium-card.silver .podium-medal {
            background: linear-gradient(135deg, #D4D4D8, #A1A1AA);
            color: #FFF;
            box-shadow: 0 2px 12px rgba(161, 161, 170, 0.3);
        }

        .podium-card.bronze .podium-medal {
            background: linear-gradient(135deg, #D97757, #A0522D);
            color: #FFF;
            box-shadow: 0 2px 12px rgba(160, 82, 45, 0.3);
        }

        .podium-name {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 12px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .podium-score {
            font-size: 24px;
            font-weight: 700;
            color: var(--text-primary);
            letter-spacing: -0.5px;
            margin-bottom: 4px;
        }

        .podium-label {
            font-size: 11px;
            color: var(--text-tertiary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 500;
        }

        .podium-detail {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 14px;
            padding-top: 14px;
            border-top: 1px solid var(--border-subtle);
        }

        .podium-tag {
            font-size: 12px;
            font-weight: 600;
            padding: 3px 8px;
            border-radius: var(--radius-sm);
        }

        .podium-tag.ok {
            color: var(--success);
            background: var(--success-light);
        }

        .podium-tag.no {
            color: var(--error);
            background: var(--error-light);
        }

        /* ─── Leaderboard Table ─── */
        .board {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
        }

        .board-head {
            display: grid;
            grid-template-columns: 52px 1fr 80px 80px 80px 90px 90px 100px;
            padding: 12px 20px;
            background: var(--bg-subtle);
            border-bottom: 1px solid var(--border);
        }

        .board-head span {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-tertiary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .board-head span:nth-child(n+3) {
            text-align: center;
        }

        .board-body {
            /* container for rows */
        }

        .board-row {
            display: grid;
            grid-template-columns: 52px 1fr 80px 80px 80px 90px 90px 100px;
            padding: 14px 20px;
            align-items: center;
            border-bottom: 1px solid var(--border-subtle);
            transition: background var(--transition);
        }

        .board-row:last-child {
            border-bottom: none;
        }

        .board-row:hover {
            background: var(--bg-hover);
        }

        .row-rank {
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-tertiary);
            background: var(--bg-subtle);
            border-radius: var(--radius-sm);
        }

        .board-row:nth-child(1) .row-rank,
        .board-row:nth-child(2) .row-rank,
        .board-row:nth-child(3) .row-rank {
            color: var(--accent);
            background: var(--accent-light);
            font-weight: 700;
        }

        .row-name {
            font-size: 14px;
            font-weight: 500;
            color: var(--text-primary);
            padding-left: 4px;
        }

        .row-stat {
            text-align: center;
            font-size: 14px;
            font-weight: 600;
            font-variant-numeric: tabular-nums;
        }

        .row-stat.ok {
            color: var(--success);
        }

        .row-stat.no {
            color: var(--error);
        }

        .row-stat.total {
            color: var(--text-secondary);
        }

        /* ─── Empty State ─── */
        .empty {
            text-align: center;
            padding: 60px 20px;
        }

        .empty-icon {
            width: 48px;
            height: 48px;
            color: var(--text-tertiary);
            opacity: 0.4;
            margin-bottom: 16px;
        }

        .empty-text {
            font-size: 14px;
            color: var(--text-tertiary);
        }

        /* ─── Footer ─── */
        .footer {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-top: 28px;
            flex-wrap: wrap;
        }

        .footer-tag {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: var(--text-tertiary);
            background: var(--bg-card);
            border: 1px solid var(--border);
            padding: 6px 14px;
            border-radius: 100px;
        }

        .footer-tag .dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--accent);
        }

        /* ─── Responsive ─── */
        @media (max-width: 640px) {
            .container {
                padding: 28px 14px 48px;
            }

            .header-title {
                font-size: 22px;
            }

            .podium {
                grid-template-columns: 1fr;
                gap: 10px;
            }

            .podium-card {
                padding: 20px 16px 18px;
            }

            .podium-card.gold {
                order: 0;
            }

            .podium-card.silver {
                order: 1;
            }

            .podium-card.bronze {
                order: 2;
            }

            .podium-score {
                font-size: 20px;
            }

            .board-head,
            .board-row {
                grid-template-columns: 40px 1fr 56px 56px 56px 60px 60px 70px;
                padding: 12px 14px;
            }

            .board-head span {
                font-size: 10px;
            }

            .row-name {
                font-size: 13px;
            }

            .row-stat {
                font-size: 13px;
            }
        }

        /* ─── Animations ─── */
        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .podium {
            animation: fadeUp 0.5s ease-out;
        }

        .board {
            animation: fadeUp 0.5s ease-out 0.1s both;
        }


        /* --- Dashboard Specific Forms & Charts --- */
        .page-header {
            margin-bottom: 24px;
            padding: 0 24px;
        }

        .page-title {
            font-size: 24px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 4px;
        }

        .page-subtitle {
            font-size: 14px;
            color: var(--text-secondary);
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 24px;
            padding: 0 24px;
        }

        .stat-card {
            background: var(--bg-card);
            border-radius: var(--radius-md);
            padding: 20px;
            border: 1px solid var(--border);
            transition: transform var(--transition);
        }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-sm);
        }

        .stat-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .stat-label {
            font-size: 13px;
            font-weight: 500;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-icon {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            font-size: 18px;
        }

        .stat-card .stat-icon {
            background: var(--bg-subtle);
            color: var(--text-tertiary);
        }

        .stat-card.success .stat-icon {
            background: var(--success-light);
            color: var(--success);
        }

        .stat-card.error .stat-icon {
            background: var(--error-light);
            color: var(--error);
        }

        .stat-card.warning .stat-icon {
            background: rgba(245, 158, 11, 0.1);
            color: #f59e0b;
        }

        .stat-value {
            font-size: 28px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 4px;
        }

        .stat-subtext {
            font-size: 12px;
            color: var(--text-tertiary);
        }

        .charts-section {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
            margin-bottom: 32px;
            padding: 0 24px;
        }

        .chart-card {
            background: var(--bg-card);
            border-radius: var(--radius-md);
            padding: 20px;
            border: 1px solid var(--border);
        }

        .chart-card.full-width {
            grid-column: 1 / -1;
        }

        .chart-header {
            margin-bottom: 16px;
        }

        .chart-title {
            font-size: 15px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .chart-subtitle {
            font-size: 13px;
            color: var(--text-tertiary);
            margin-top: 2px;
        }

        .chart-container {
            position: relative;
            height: 260px;
        }

        .chart-container.small {
            height: 220px;
        }

        .section-card {
            background: var(--bg-card);
            border-radius: var(--radius-md);
            margin-bottom: 24px;
            border: 1px solid var(--border);
            overflow: hidden;
            margin-left: 24px;
            margin-right: 24px;
        }

        .section-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .section-title {
            font-size: 15px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .section-body {
            padding: 20px;
        }

        .upload-area {
            border: 2px dashed var(--border);
            border-radius: var(--radius-md);
            padding: 40px;
            text-align: center;
            background: var(--bg-subtle);
            cursor: pointer;
            transition: all 0.2s;
        }

        .upload-area:hover {
            border-color: var(--accent);
            background: var(--accent-light);
        }

        .upload-icon {
            font-size: 32px;
            margin-bottom: 12px;
            opacity: 0.5;
        }

        .upload-text {
            font-size: 14px;
            color: var(--text-primary);
            font-weight: 500;
        }

        .upload-hint {
            font-size: 12px;
            color: var(--text-secondary);
            margin-top: 8px;
        }

        .form-grid {
            display: flex;
            gap: 12px;
            align-items: flex-end;
            flex-wrap: wrap;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .form-group.input-name {
            flex: 1;
            min-width: 200px;
        }

        .form-label {
            font-size: 12px;
            font-weight: 500;
            color: var(--text-secondary);
        }

        .form-input {
            padding: 10px 12px;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            font-size: 14px;
            background: var(--bg-input);
            color: var(--text-primary);
            width: 100%;
            transition: border-color 0.2s;
            font-family: inherit;
        }

        .form-input:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-light);
        }

        .form-checkbox {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            color: var(--text-primary);
            cursor: pointer;
        }

        .form-checkbox input {
            width: 16px;
            height: 16px;
            accent-color: var(--accent);
            cursor: pointer;
        }

        .header {
            background: var(--bg-card);
            border-bottom: 1px solid var(--border);
            padding: 0 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 56px;
            margin-bottom: 24px;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .header-nav {
            display: flex;
            gap: 4px;
        }

        .nav-item {
            padding: 6px 12px;
            border-radius: var(--radius-sm);
            font-size: 13px;
            font-weight: 500;
            color: var(--text-secondary);
            text-decoration: none;
            transition: 0.2s;
        }

        .nav-item:hover,
        .nav-item.active {
            background: var(--bg-subtle);
            color: var(--text-primary);
        }

        .empty-state {
            text-align: center;
            padding: 48px 24px;
        }

        .empty-icon {
            font-size: 40px;
            margin-bottom: 12px;
            opacity: 0.3;
        }

        .empty-title {
            font-size: 16px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .empty-text {
            font-size: 13px;
            color: var(--text-secondary);
            margin-top: 4px;
        }

        .expandable-form {
            display: none;
            margin-top: 12px;
            padding: 12px;
            background: var(--bg-subtle);
            border-radius: var(--radius-sm);
        }

        .expandable-form.show {
            display: block;
        }

        .form-inline {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        /* ─── Buttons ─── */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 10px 16px;
            border-radius: var(--radius-sm);
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all var(--transition);
            border: 1px solid transparent;
            text-decoration: none;
            font-family: inherit;
            line-height: 1;
            white-space: nowrap;
        }

        .btn-primary {
            background: var(--accent);
            color: #fff;
            border-color: var(--accent);
        }

        .btn-primary:hover {
            background: var(--accent-hover);
            border-color: var(--accent-hover);
        }

        .btn-outline {
            background: transparent;
            color: var(--text-secondary);
            border-color: var(--border);
        }

        .btn-outline:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
        }

        .btn-small {
            padding: 6px 12px;
            font-size: 13px;
        }

        /* ─── Alerts ─── */
        .alert {
            padding: 12px 16px;
            border-radius: var(--radius-md);
            margin-bottom: 16px;
            font-size: 14px;
            font-weight: 500;
        }

        .alert-success {
            background: var(--success-light);
            color: var(--success);
            border: 1px solid rgba(45, 138, 86, 0.2);
        }

        .alert-error {
            background: var(--error-light);
            color: var(--error);
            border: 1px solid rgba(196, 68, 42, 0.2);
        }

        /* ─── Tags ─── */
        .tags {
            display: flex;
            gap: 8px;
            margin-bottom: 12px;
            justify-content: center;
        }

        .tag {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 4px 10px;
            border-radius: 100px;
            background: var(--accent-light);
            color: var(--accent);
        }

        /* ─── Table Utilities ─── */
        .head-cell {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-tertiary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .text-right {
            text-align: right;
        }

        /* ─── Dashboard Board ─── */
        .dashboard-board .board-head,
        .dashboard-board .board-row {
            grid-template-columns: 90px 1.5fr 60px 100px 70px 70px 110px 1fr;
            align-items: center;
            padding: 12px 24px;
        }

        .dashboard-board .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            justify-content: flex-end;
        }

        .dashboard-board .btn-small {
            padding: 6px 10px;
            font-size: 12px;
        }

        .dashboard-board .expandable-form {
            grid-column: 1 / -1;
            display: none;
            margin-top: 12px;
            padding: 16px;
            background: var(--bg-subtle);
            border-radius: var(--radius-sm);
        }

        .dashboard-board .expandable-form.show {
            display: block;
        }

        .dashboard-board .admin-badge {
            display: inline-flex;
            align-items: center;
            padding: 2px 6px;
            background: var(--accent-light);
            color: var(--accent);
            font-size: 10px;
            font-weight: 600;
            border-radius: 4px;
            text-transform: uppercase;
        }
    </style>
</head>

