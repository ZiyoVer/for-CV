<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>STT Admin Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Inter', sans-serif;
            background: #f5f5f5;
            color: #000;
            padding: 20px;
        }

        .container { max-width: 1400px; margin: 0 auto; }

        .header {
            background: white;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header h1 { font-size: 24px; }

        .btn {
            background: #000;
            color: #fff;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
        }

        .btn:hover { opacity: 0.8; }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 20px;
        }

        .stat-card {
            background: white;
            padding: 24px;
            border-radius: 12px;
            border-left: 4px solid #3b82f6;
        }

        .stat-card.accepted { border-left-color: #22c55e; }
        .stat-card.rejected { border-left-color: #ef4444; }
        .stat-card.pending { border-left-color: #f59e0b; }

        .stat-label {
            font-size: 12px;
            text-transform: uppercase;
            color: #666;
            margin-bottom: 8px;
        }

        .stat-value {
            font-size: 32px;
            font-weight: 700;
            color: #3b82f6;
        }

        .stat-card.accepted .stat-value { color: #22c55e; }
        .stat-card.rejected .stat-value { color: #ef4444; }
        .stat-card.pending .stat-value { color: #f59e0b; }

        .stat-subtext {
            font-size: 12px;
            color: #999;
            margin-top: 4px;
        }

        .charts {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        .chart-box {
            background: white;
            padding: 24px;
            border-radius: 12px;
            height: 350px;
        }

        .chart-title {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 16px;
        }

        .upload-section {
            background: white;
            padding: 40px;
            border-radius: 12px;
            text-align: center;
            margin-bottom: 20px;
            border: 2px dashed #ddd;
        }

        .table-section {
            background: white;
            border-radius: 12px;
            overflow: hidden;
        }

        .table-header {
            padding: 20px;
            border-bottom: 1px solid #eee;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            text-align: left;
            padding: 16px 20px;
            font-size: 12px;
            text-transform: uppercase;
            color: #666;
            background: #f9f9f9;
            border-bottom: 1px solid #eee;
        }

        td {
            padding: 16px 20px;
            border-bottom: 1px solid #eee;
            font-size: 14px;
        }

        tr:hover { background: #f9f9f9; }

        .action-cell {
            display: flex;
            gap: 8px;
        }

        .action-btn {
            width: 32px;
            height: 32px;
            border: 1px solid #ddd;
            background: white;
            border-radius: 6px;
            cursor: pointer;
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .action-btn:hover {
            background: #000;
            color: white;
            border-color: #000;
        }

        /* MODAL */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }

        .modal-overlay.show {
            display: flex;
        }

        .modal {
            background: white;
            padding: 32px;
            border-radius: 12px;
            width: 90%;
            max-width: 450px;
        }

        .modal-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-group label {
            display: block;
            margin-bottom: 6px;
            font-size: 13px;
            font-weight: 600;
        }

        .form-input {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 6px;
            font-size: 14px;
        }

        .form-input:focus {
            outline: none;
            border-color: #000;
        }

        .modal-actions {
            display: flex;
            gap: 12px;
            margin-top: 20px;
        }

        .btn-full {
            flex: 1;
        }

        .btn-outline {
            background: white;
            color: #000;
            border: 1px solid #ddd;
        }

        @media (max-width: 1024px) {
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
            .charts { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <h1>📊 STT Admin Dashboard</h1>
        <a href="/logout" class="btn">🚪 Chiqish</a>
    </div>

    <!-- Stats -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">Total Checked</div>
            <div class="stat-value"><%= stats.totalChecked %></div>
            <div class="stat-subtext">ta fayl</div>
        </div>
        <div class="stat-card accepted">
            <div class="stat-label">Accepted</div>
            <div class="stat-value"><%= stats.totalAccepted %></div>
            <div class="stat-subtext"><%= stats.checkedDuration %></div>
        </div>
        <div class="stat-card rejected">
            <div class="stat-label">Rejected</div>
            <div class="stat-value"><%= stats.totalRejected %></div>
            <div class="stat-subtext">ta fayl</div>
        </div>
        <div class="stat-card pending">
            <div class="stat-label">Pending</div>
            <div class="stat-value"><%= stats.pending %></div>
            <div class="stat-subtext"><%= stats.pendingDuration %></div>
        </div>
    </div>

    <!-- Charts -->
    <div class="charts">
        <div class="chart-box">
            <div class="chart-title">📈 Umumiy Statistika (30 kun)</div>
            <canvas id="lifetimeChart"></canvas>
        </div>
        <div class="chart-box">
            <div class="chart-title">⚡ 24 Soatlik Faollik</div>
            <canvas id="dailyChart"></canvas>
        </div>
    </div>

    <!-- Upload -->
    <div class="upload-section">
        <h3>☁️ Audio Yuklash (Transkripsiya)</h3>
        <p style="color: #999; margin: 12px 0;">S3 ga audio fayllar yuklang (Max 100 ta)</p>
        <form action="/transcription/upload" method="POST" enctype="multipart/form-data">
            <input type="file" name="audioFiles" id="fileInput" multiple accept="audio/*" style="display:none;" onchange="updateFileCount()">
            <button type="button" class="btn btn-outline" onclick="document.getElementById('fileInput').click()">📁 Fayllarni Tanlash</button>
            <button type="submit" class="btn" style="margin-left: 8px;">⬆️ Yuklash</button>
        </form>
        <p id="file-label" style="margin-top: 12px; color: #999; font-size: 13px;"></p>
    </div>

    <!-- Users Table -->
    <div class="table-section">
        <div class="table-header">
            <h3>👥 Foydalanuvchilar</h3>
            <button class="btn" onclick="openAddModal()">➕ Yangi Foydalanuvchi</button>
        </div>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Ism</th>
                    <th style="text-align:right;">Bugun</th>
                    <th style="text-align:right;">Jami OK</th>
                    <th style="text-align:right;">Jami NO</th>
                    <th style="text-align:right;">Balans</th>
                    <th style="text-align:right;">Amallar</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(user => { %>
                <tr>
                    <td><%= user.telegram_id %></td>
                    <td><%= user.full_name %> <% if(user.is_admin) { %>🛡️<% } %></td>
                    <td style="text-align:right;">
                        <% if(user.checks_today > 0) { %>
                            <span style="color:#22c55e;font-weight:600;">+<%= user.checks_today %></span>
                        <% } else { %>-<% } %>
                    </td>
                    <td style="text-align:right;"><%= user.total_accepted || 0 %></td>
                    <td style="text-align:right;"><%= user.total_rejected || 0 %></td>
                    <td style="text-align:right;font-weight:600;"><%= user.balance.toLocaleString() %> so'm</td>
                    <td>
                        <div class="action-cell" style="justify-content:flex-end;">
                            <button class="action-btn" onclick="window.location.href='/review/<%= user.telegram_id %>'" title="Tekshirish">🎧</button>
                            <button class="action-btn" onclick="openBalanceModal(<%= user.telegram_id %>,'<%= user.full_name %>')" title="Balans qo'shish">💰</button>
                            <button class="action-btn" onclick="openPayoutModal(<%= user.telegram_id %>,'<%= user.full_name %>',<%= user.balance %>)" title="To'lov">💸</button>
                            <button class="action-btn" onclick="openEditModal(<%= user.telegram_id %>,'<%= user.full_name %>',<%= user.is_admin %>)" title="Tahrirlash">✏️</button>
                            <form action="/users/delete/<%= user.telegram_id %>" method="POST" onsubmit="return confirm('O\'chirish?')" style="display:inline;margin:0;">
                                <button type="submit" class="action-btn" title="O'chirish" style="color:#ef4444;">🗑️</button>
                            </form>
                        </div>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<!-- Add User Modal -->
<div id="addModal" class="modal-overlay" onclick="if(event.target===this) closeModal('addModal')">
    <div class="modal">
        <h3 class="modal-title">➕ Yangi Foydalanuvchi</h3>
        <form action="/users/add" method="POST">
            <div class="form-group">
                <label>Telegram ID</label>
                <input type="number" name="telegram_id" class="form-input" required>
            </div>
            <div class="form-group">
                <label>To'liq Ism</label>
                <input type="text" name="full_name" class="form-input" required>
            </div>
            <div class="form-group">
                <input type="checkbox" name="is_admin" id="addIsAdmin">
                <label for="addIsAdmin" style="display:inline;margin-left:6px;cursor:pointer;">Admin</label>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-outline btn-full" onclick="closeModal('addModal')">Bekor</button>
                <button type="submit" class="btn btn-full">Qo'shish</button>
            </div>
        </form>
    </div>
</div>

<!-- Balance Modal -->
<div id="balanceModal" class="modal-overlay" onclick="if(event.target===this) closeModal('balanceModal')">
    <div class="modal">
        <h3 class="modal-title">💰 Balans Qo'shish</h3>
        <p id="balanceUserName" style="color:#666;margin-bottom:16px;"></p>
        <form id="balanceForm" method="POST">
            <div class="form-group">
                <label>Summa (so'm)</label>
                <input type="number" name="amount" class="form-input" required placeholder="50000">
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-outline btn-full" onclick="closeModal('balanceModal')">Bekor</button>
                <button type="submit" class="btn btn-full">Qo'shish</button>
            </div>
        </form>
    </div>
</div>

<!-- Payout Modal -->
<div id="payoutModal" class="modal-overlay" onclick="if(event.target===this) closeModal('payoutModal')">
    <div class="modal">
        <h3 class="modal-title">💸 To'lovni Tasdiqlash</h3>
        <p>Foydalanuvchi: <b id="payoutUserName"></b></p>
        <p style="margin-bottom:20px;">Summa: <b id="payoutAmount"></b> so'm</p>
        <form id="payoutForm" method="POST">
            <div class="modal-actions">
                <button type="button" class="btn btn-outline btn-full" onclick="closeModal('payoutModal')">Bekor</button>
                <button type="submit" class="btn btn-full">To'lab Berildi</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Modal -->
<div id="editModal" class="modal-overlay" onclick="if(event.target===this) closeModal('editModal')">
    <div class="modal">
        <h3 class="modal-title">✏️ Tahrirlash</h3>
        <form id="editForm" method="POST">
            <div class="form-group">
                <label>Telegram ID</label>
                <input type="number" id="editId" class="form-input" disabled style="opacity:0.6;">
            </div>
            <div class="form-group">
                <label>To'liq Ism</label>
                <input type="text" name="full_name" id="editName" class="form-input" required>
            </div>
            <div class="form-group">
                <input type="checkbox" name="is_admin" id="editIsAdmin">
                <label for="editIsAdmin" style="display:inline;margin-left:6px;cursor:pointer;">Admin</label>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-outline btn-full" onclick="closeModal('editModal')">Bekor</button>
                <button type="submit" class="btn btn-full">Saqlash</button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
console.log('🚀 Dashboard loaded');

// Modal functions
function openModal(id) {
    console.log('Opening modal:', id);
    document.getElementById(id).classList.add('show');
}

function closeModal(id) {
    console.log('Closing modal:', id);
    document.getElementById(id).classList.remove('show');
}

function openAddModal() {
    openModal('addModal');
}

function openBalanceModal(id, name) {
    document.getElementById('balanceUserName').textContent = 'Foydalanuvchi: ' + name;
    document.getElementById('balanceForm').action = '/users/add-balance/' + id;
    openModal('balanceModal');
}

function openPayoutModal(id, name, amount) {
    document.getElementById('payoutUserName').textContent = name;
    document.getElementById('payoutAmount').textContent = amount.toLocaleString();
    document.getElementById('payoutForm').action = '/users/payout/' + id;
    openModal('payoutModal');
}

function openEditModal(id, name, isAdmin) {
    document.getElementById('editId').value = id;
    document.getElementById('editName').value = name;
    document.getElementById('editIsAdmin').checked = isAdmin;
    document.getElementById('editForm').action = '/users/update/' + id;
    openModal('editModal');
}

function updateFileCount() {
    const input = document.getElementById('fileInput');
    const label = document.getElementById('file-label');
    if (input.files && input.files.length > 0) {
        label.textContent = input.files.length + ' ta fayl tanlandi';
    } else {
        label.textContent = '';
    }
}

// Charts
document.addEventListener('DOMContentLoaded', () => {
    console.log('📊 Initializing charts...');

    try {
        const chartData = <%= JSON.stringify(typeof chartData !== 'undefined' ? chartData : []) %>;
        const lifetimeStats = <%= JSON.stringify(typeof lifetimeStats !== 'undefined' ? lifetimeStats : []) %>;

        console.log('Chart data:', chartData.length, 'items');
        console.log('Lifetime data:', lifetimeStats.length, 'items');

        // Lifetime Chart
        const ctxLifetime = document.getElementById('lifetimeChart');
        if (ctxLifetime) {
            new Chart(ctxLifetime, {
                type: 'bar',
                data: {
                    labels: lifetimeStats.map(d => {
                        const date = new Date(d.day);
                        return date.toLocaleDateString('uz-UZ', { day: '2-digit', month: '2-digit' });
                    }),
                    datasets: [
                        {
                            label: 'Qabul',
                            data: lifetimeStats.map(d => d.accepted),
                            backgroundColor: '#22c55e',
                            borderRadius: 4,
                            stack: 'Stack 0'
                        },
                        {
                            label: 'Rad',
                            data: lifetimeStats.map(d => d.rejected),
                            backgroundColor: '#ef4444',
                            borderRadius: 4,
                            stack: 'Stack 0'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: { stacked: true, grid: { display: false } },
                        y: { stacked: true, beginAtZero: true }
                    },
                    plugins: {
                        legend: { position: 'top' }
                    }
                }
            });
            console.log('✅ Lifetime chart created');
        }

        // Daily Chart
        const ctxDaily = document.getElementById('dailyChart');
        if (ctxDaily) {
            new Chart(ctxDaily, {
                type: 'line',
                data: {
                    labels: chartData.map(d => {
                        const date = new Date(d.hour);
                        return date.getHours() + ':00';
                    }),
                    datasets: [{
                        label: 'Tekshiruvlar',
                        data: chartData.map(d => d.count),
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59,130,246,0.1)',
                        tension: 0.4,
                        fill: true,
                        pointRadius: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false } },
                        y: { beginAtZero: true }
                    }
                }
            });
            console.log('✅ Daily chart created');
        }
    } catch (error) {
        console.error('❌ Chart error:', error);
    }
});

console.log('✅ All scripts loaded successfully');
</script>
</body>
</html>
