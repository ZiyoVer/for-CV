<!DOCTYPE html>
<html lang="uz">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>STT Leaderboard - Live Reyting</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-primary: #f9fafb;
            --bg-secondary: #ffffff;
            --bg-tertiary: #f3f4f6;
            --text-primary: #111827;
            --text-secondary: #6b7280;
            --text-muted: #9ca3af;
            --border-color: #e5e7eb;
            --accent: #d97757;
            --accent-light: rgba(217, 119, 87, 0.1);
            --success: #10b981;
            --success-light: rgba(16, 185, 129, 0.1);
            --error: #ef4444;
            --error-light: rgba(239, 68, 68, 0.1);
            --gold: #f59e0b;
            --gold-light: rgba(245, 158, 11, 0.15);
            --silver: #6b7280;
            --silver-light: rgba(107, 114, 128, 0.1);
            --bronze: #ea580c;
            --bronze-light: rgba(234, 88, 12, 0.1);
            --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg-primary);
            min-height: 100vh;
            color: var(--text-primary);
        }

        /* Navbar */
        .navbar {
            background: var(--bg-secondary);
            border-bottom: 1px solid var(--border-color);
            padding: 16px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .navbar-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo {
            font-size: 18px;
            font-weight: 700;
            color: var(--text-primary);
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-icon {
            width: 28px;
            height: 28px;
            color: var(--gold);
        }

        .live-indicator {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: var(--success);
            font-weight: 600;
            background: var(--success-light);
            padding: 6px 12px;
            border-radius: 20px;
        }

        .live-dot {
            width: 8px;
            height: 8px;
            background: var(--success);
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {

            0%,
            100% {
                opacity: 1;
                transform: scale(1);
            }

            50% {
                opacity: 0.5;
                transform: scale(1.3);
            }
        }

        /* Container */
        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        /* Header */
        .header {
            text-align: center;
            margin-bottom: 40px;
        }

        .header h1 {
            font-size: 32px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 8px;
            letter-spacing: -0.5px;
        }

        .header p {
            color: var(--text-secondary);
            font-size: 15px;
        }

        .update-time {
            color: var(--text-muted);
            font-size: 13px;
            margin-top: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .update-time svg {
            width: 14px;
            height: 14px;
        }

        /* Top 3 Podium */
        .podium {
            display: flex;
            justify-content: center;
            align-items: flex-end;
            gap: 16px;
            margin-bottom: 40px;
            padding: 0 20px;
        }

        .podium-item {
            flex: 1;
            max-width: 180px;
            text-align: center;
            transition: transform 0.3s ease;
        }

        .podium-item:hover {
            transform: translateY(-4px);
        }

        .podium-card {
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 24px 16px;
            box-shadow: var(--shadow-md);
            position: relative;
            overflow: hidden;
        }

        .podium-item.first .podium-card {
            border-color: var(--gold);
            background: linear-gradient(180deg, var(--gold-light) 0%, var(--bg-secondary) 100%);
        }

        .podium-item.second .podium-card {
            border-color: var(--silver);
            background: linear-gradient(180deg, var(--silver-light) 0%, var(--bg-secondary) 100%);
        }

        .podium-item.third .podium-card {
            border-color: var(--bronze);
            background: linear-gradient(180deg, var(--bronze-light) 0%, var(--bg-secondary) 100%);
        }

        .podium-rank {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            font-weight: 700;
            margin: 0 auto 12px;
        }

        .podium-item.first .podium-rank {
            background: var(--gold);
            color: #78350f;
        }

        .podium-item.second .podium-rank {
            background: var(--silver);
            color: #ffffff;
        }

        .podium-item.third .podium-rank {
            background: var(--bronze);
            color: #ffffff;
        }

        .podium-name {
            font-size: 15px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 8px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .podium-stats {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-bottom: 12px;
        }

        .podium-stat {
            font-size: 12px;
            font-weight: 600;
            padding: 4px 8px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .podium-stat svg {
            width: 12px;
            height: 12px;
        }

        .podium-stat.accepted {
            background: var(--success-light);
            color: var(--success);
        }

        .podium-stat.rejected {
            background: var(--error-light);
            color: var(--error);
        }

        .podium-balance {
            font-size: 14px;
            font-weight: 700;
            color: var(--accent);
        }

        /* Leaderboard Table */
        .leaderboard {
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: var(--shadow-md);
        }

        .leaderboard-header {
            display: grid;
            grid-template-columns: 60px 1fr 90px 90px 90px 110px;
            background: var(--bg-tertiary);
            padding: 14px 20px;
            font-size: 11px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
            border-bottom: 1px solid var(--border-color);
        }

        .leaderboard-header .col-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
        }

        .leaderboard-header svg {
            width: 12px;
            height: 12px;
        }

        .leaderboard-row {
            display: grid;
            grid-template-columns: 60px 1fr 90px 90px 90px 110px;
            padding: 16px 20px;
            font-size: 14px;
            border-bottom: 1px solid var(--border-color);
            align-items: center;
            transition: all 0.2s ease;
        }

        .leaderboard-row:last-child {
            border-bottom: none;
        }

        .leaderboard-row:hover {
            background: var(--bg-tertiary);
        }

        .rank {
            font-weight: 700;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            border-radius: 8px;
            background: var(--bg-tertiary);
        }

        .name {
            color: var(--text-primary);
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .stat {
            text-align: center;
            font-weight: 600;
        }

        .stat.accepted {
            color: var(--success);
        }

        .stat.rejected {
            color: var(--error);
        }

        .stat.total {
            color: var(--text-secondary);
        }

        .stat.balance {
            color: var(--accent);
            font-weight: 700;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: var(--text-muted);
            font-size: 15px;
        }

        .empty-icon {
            width: 48px;
            height: 48px;
            margin: 0 auto 16px;
            color: var(--text-muted);
            opacity: 0.5;
        }

        /* Footer Features */
        .features {
            margin-top: 32px;
            display: flex;
            justify-content: center;
            gap: 24px;
            flex-wrap: wrap;
        }

        .feature {
            display: flex;
            gap: 8px;
            font-size: 13px;
            color: var(--text-secondary);
            align-items: center;
            background: var(--bg-secondary);
            padding: 10px 16px;
            border-radius: 10px;
            border: 1px solid var(--border-color);
        }

        .feature-icon {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: var(--success-light);
            color: var(--success);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .feature-icon svg {
            width: 12px;
            height: 12px;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .podium {
                flex-direction: column;
                align-items: center;
            }

            .podium-item {
                max-width: 100%;
                width: 100%;
            }

            .podium-item.first {
                order: -1;
            }

            .leaderboard-header,
            .leaderboard-row {
                grid-template-columns: 40px 1fr 60px 60px 60px 80px;
                padding: 12px 14px;
                font-size: 12px;
            }

            .header h1 {
                font-size: 24px;
            }

            .container {
                padding: 24px 12px;
            }

            .features {
                flex-direction: column;
                align-items: center;
            }
        }

        /* Animation */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .podium-item,
        .leaderboard {
            animation: fadeIn 0.5s ease-out;
        }
    </style>
</head>

<body>
    <nav class="navbar">
        <div class="navbar-left">
            <div class="logo">
                <svg class="logo-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path
                        d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" />
                </svg>
                <span>Leaderboard</span>
            </div>
        </div>
        <div class="live-indicator">
            <span class="live-dot"></span>
            <span>LIVE</span>
        </div>
    </nav>

    <div class="container">
        <div class="header">
            <h1>Annotatorlar Reytingi</h1>
            <p>Eng ko'p audio tekshirgan annotatorlar</p>
            <div class="update-time" id="updateTime">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M23 4v6h-6M1 20v-6h6" />
                    <path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15" />
                </svg>
                <span>Yuklanmoqda...</span>
            </div>
        </div>

        <% if (leaderboard.length>= 3) { %>
            <!-- Top 3 Podium -->
            <div class="podium">
                <div class="podium-item second">
                    <div class="podium-card">
                        <div class="podium-rank">2</div>
                        <div class="podium-name">
                            <%= leaderboard[1].name %>
                        </div>
                        <div class="podium-stats">
                            <span class="podium-stat accepted">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                    <polyline points="20 6 9 17 4 12" />
                                </svg>
                                <%= leaderboard[1].accepted %>
                            </span>
                            <span class="podium-stat rejected">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                    <line x1="18" y1="6" x2="6" y2="18" />
                                    <line x1="6" y1="6" x2="18" y2="18" />
                                </svg>
                                <%= leaderboard[1].rejected %>
                            </span>
                        </div>
                        <div class="podium-balance">
                            <%= leaderboard[1].balance.toLocaleString() %> so'm
                        </div>
                    </div>
                </div>
                <div class="podium-item first">
                    <div class="podium-card">
                        <div class="podium-rank">1</div>
                        <div class="podium-name">
                            <%= leaderboard[0].name %>
                        </div>
                        <div class="podium-stats">
                            <span class="podium-stat accepted">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                    <polyline points="20 6 9 17 4 12" />
                                </svg>
                                <%= leaderboard[0].accepted %>
                            </span>
                            <span class="podium-stat rejected">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                    <line x1="18" y1="6" x2="6" y2="18" />
                                    <line x1="6" y1="6" x2="18" y2="18" />
                                </svg>
                                <%= leaderboard[0].rejected %>
                            </span>
                        </div>
                        <div class="podium-balance">
                            <%= leaderboard[0].balance.toLocaleString() %> so'm
                        </div>
                    </div>
                </div>
                <div class="podium-item third">
                    <div class="podium-card">
                        <div class="podium-rank">3</div>
                        <div class="podium-name">
                            <%= leaderboard[2].name %>
                        </div>
                        <div class="podium-stats">
                            <span class="podium-stat accepted">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                    <polyline points="20 6 9 17 4 12" />
                                </svg>
                                <%= leaderboard[2].accepted %>
                            </span>
                            <span class="podium-stat rejected">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                    <line x1="18" y1="6" x2="6" y2="18" />
                                    <line x1="6" y1="6" x2="18" y2="18" />
                                </svg>
                                <%= leaderboard[2].rejected %>
                            </span>
                        </div>
                        <div class="podium-balance">
                            <%= leaderboard[2].balance.toLocaleString() %> so'm
                        </div>
                    </div>
                </div>
            </div>
            <% } %>

                <div class="leaderboard">
                    <div class="leaderboard-header">
                        <div>#</div>
                        <div>Ism</div>
                        <div class="col-icon" style="text-align:center">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12" />
                            </svg>
                            Qabul
                        </div>
                        <div class="col-icon" style="text-align:center">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="6" x2="6" y2="18" />
                                <line x1="6" y1="6" x2="18" y2="18" />
                            </svg>
                            Rad
                        </div>
                        <div style="text-align:center">Jami</div>
                        <div class="col-icon" style="text-align:center">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10" />
                                <path d="M12 6v6l4 2" />
                            </svg>
                            Balans
                        </div>
                    </div>
                    <div id="leaderboardBody">
                        <% if (leaderboard.length===0) { %>
                            <div class="empty-state">
                                <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                    stroke-width="1.5">
                                    <path d="M3 3v18h18" />
                                    <path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3" />
                                </svg>
                                <div>Hali hech kim tekshirmagan.</div>
                            </div>
                            <% } else { %>
                                <% leaderboard.forEach(function(user) { %>
                                    <div class="leaderboard-row">
                                        <div class="rank">
                                            <%= user.rank %>
                                        </div>
                                        <div class="name">
                                            <%= user.name %>
                                        </div>
                                        <div class="stat accepted">
                                            <%= user.accepted %>
                                        </div>
                                        <div class="stat rejected">
                                            <%= user.rejected %>
                                        </div>
                                        <div class="stat total">
                                            <%= user.total %>
                                        </div>
                                        <div class="stat balance">
                                            <%= user.balance.toLocaleString() %>
                                        </div>
                                    </div>
                                    <% }); %>
                                        <% } %>
                    </div>
                </div>

                <div class="features">
                    <div class="feature">
                        <div class="feature-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                <polyline points="20 6 9 17 4 12" />
                            </svg>
                        </div>
                        <span><strong>Auto-refresh</strong> 5s</span>
                    </div>
                    <div class="feature">
                        <div class="feature-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                <polyline points="20 6 9 17 4 12" />
                            </svg>
                        </div>
                        <span><strong>Real-time</strong> Jonli</span>
                    </div>
                    <div class="feature">
                        <div class="feature-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                <polyline points="20 6 9 17 4 12" />
                            </svg>
                        </div>
                        <span><strong>Top 3</strong> Podium</span>
                    </div>
                </div>
    </div>

    <script>
        function updateLeaderboard() {
            fetch('/api/leaderboard')
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (!data.success) return;

                    var body = document.getElementById('leaderboardBody');

                    // Helper function to escape HTML
                    var escapeHtml = function (text) {
                        var div = document.createElement('div');
                        div.textContent = text;
                        return div.innerHTML;
                    };

                    if (data.leaderboard.length === 0) {
                        body.innerHTML = '<div class="empty-state"><svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3v18h18"/><path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"/></svg><div>Hali hech kim tekshirmagan.</div></div>';
                    } else {
                        body.innerHTML = data.leaderboard.map(function (user) {
                            return '<div class="leaderboard-row"><div class="rank">' + user.rank + '</div><div class="name">' + escapeHtml(user.name) + '</div><div class="stat accepted">' + user.accepted + '</div><div class="stat rejected">' + user.rejected + '</div><div class="stat total">' + user.total + '</div><div class="stat balance">' + user.balance.toLocaleString() + '</div></div>';
                        }).join('');
                    }

                    // Update time
                    var time = new Date(data.updatedAt).toLocaleTimeString('uz-UZ');
                    document.getElementById('updateTime').innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6M1 20v-6h6"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg><span>Oxirgi yangilanish: ' + time + '</span>';
                })
                .catch(function (err) { console.error('Update error:', err); });
        }

        // Auto-refresh every 5 seconds
        setInterval(updateLeaderboard, 5000);

        // Initial time display
        document.getElementById('updateTime').innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6M1 20v-6h6"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/></svg><span>Oxirgi yangilanish: ' + new Date().toLocaleTimeString('uz-UZ') + '</span>';
    </script>
</body>

</html>