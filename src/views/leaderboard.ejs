<!DOCTYPE html>
<html lang="uz">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>STT Leaderboard - Live Reyting</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-body: #f3f4f6;
            --bg-card: #ffffff;
            --text-primary: #111827;
            --text-secondary: #6b7280;
            --border-color: #e5e7eb;
            --gold: #fef3c7;
            --gold-text: #b45309;
            --silver: #f3f4f6;
            --silver-text: #374151;
            --bronze: #ffedd5;
            --bronze-text: #9a3412;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--bg-body);
            min-height: 100vh;
            color: var(--text-primary);
        }

        .navbar {
            background: var(--bg-card);
            border-bottom: 1px solid var(--border-color);
            padding: 12px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        }

        .logo {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-primary);
            letter-spacing: -0.5px;
        }

        .live-indicator {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: #16a34a;
            font-weight: 600;
        }

        .live-dot {
            width: 8px;
            height: 8px;
            background: #16a34a;
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {

            0%,
            100% {
                opacity: 1;
                transform: scale(1);
            }

            50% {
                opacity: 0.5;
                transform: scale(1.2);
            }
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 32px 16px;
        }

        .header {
            text-align: center;
            margin-bottom: 32px;
        }

        .header h1 {
            font-size: 28px;
            background: linear-gradient(135deg, #2563eb 0%, #7c3aed 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 8px;
            letter-spacing: -0.5px;
        }

        .header p {
            color: var(--text-secondary);
            font-size: 14px;
        }

        .update-time {
            color: #9ca3af;
            font-size: 12px;
            margin-top: 8px;
        }

        .leaderboard {
            border: 1px solid var(--border-color);
            border-radius: 16px;
            overflow: hidden;
            background: var(--bg-card);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }

        .leaderboard-header {
            display: grid;
            grid-template-columns: 50px 1fr 80px 80px 80px 100px;
            background: #f9fafb;
            padding: 12px 16px;
            font-size: 11px;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
            border-bottom: 1px solid var(--border-color);
        }

        .leaderboard-row {
            display: grid;
            grid-template-columns: 50px 1fr 80px 80px 80px 100px;
            padding: 12px 16px;
            font-size: 13px;
            border-bottom: 1px solid #f3f4f6;
            align-items: center;
            transition: all 0.2s;
        }

        .leaderboard-row:hover {
            background: #fdfbf7;
            transform: scale(1.005);
        }

        /* Top 3 Styling */
        .leaderboard-row.rank-1 {
            background: linear-gradient(to right, #fffbeb, #ffffff);
            border-left: 4px solid #f59e0b;
        }

        .leaderboard-row.rank-2 {
            background: linear-gradient(to right, #f9fafb, #ffffff);
            border-left: 4px solid #9ca3af;
        }

        .leaderboard-row.rank-3 {
            background: linear-gradient(to right, #fff7ed, #ffffff);
            border-left: 4px solid #ea580c;
        }

        .rank {
            font-weight: 700;
            color: #9ca3af;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 24px;
            height: 24px;
            border-radius: 50%;
        }

        .rank-1 .rank {
            background: #fcd34d;
            color: #78350f;
        }

        .rank-2 .rank {
            background: #e5e7eb;
            color: #374151;
        }

        .rank-3 .rank {
            background: #fed7aa;
            color: #7c2d12;
        }

        .name {
            color: var(--text-primary);
            font-weight: 600;
        }

        .stat {
            text-align: center;
        }

        .stat.accepted {
            color: #059669;
            font-weight: 600;
            background: #ecfdf5;
            padding: 2px 6px;
            border-radius: 4px;
            display: inline-block;
        }

        .stat.rejected {
            color: #dc2626;
            background: #fef2f2;
            padding: 2px 6px;
            border-radius: 4px;
            display: inline-block;
        }

        .stat.total {
            color: var(--text-secondary);
            font-weight: 500;
        }

        .stat.balance {
            color: #2563eb;
            font-weight: 700;
        }

        .trophy {
            display: none;
        }

        /* Hidden, using rank circles */

        .empty-state {
            text-align: center;
            padding: 60px;
            color: var(--text-secondary);
            font-size: 14px;
        }

        .feature-list {
            margin-top: 32px;
            display: flex;
            justify-content: center;
            gap: 24px;
            flex-wrap: wrap;
        }

        .feature-item {
            display: flex;
            gap: 8px;
            font-size: 12px;
            color: var(--text-secondary);
            align-items: center;
        }

        .feature-icon {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: #d1fae5;
            color: #059669;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
        }

        @media (max-width: 640px) {

            .leaderboard-header,
            .leaderboard-row {
                grid-template-columns: 30px 1fr 50px 50px 50px 70px;
                padding: 10px;
                font-size: 11px;
            }

            .name {
                font-size: 12px;
            }

            .header h1 {
                font-size: 22px;
            }

            .container {
                padding: 16px 8px;
            }

            .stat.accepted,
            .stat.rejected {
                padding: 2px 4px;
            }
        }
    </style>
</head>

<body>
    <nav class="navbar">
        <div class="logo">🏆 STT Leaderboard</div>
        <div class="live-indicator">
            <span class="live-dot"></span>
            <span>LIVE</span>
        </div>
    </nav>

    <div class="container">
        <div class="header">
            <h1>Annotatorlar Reytingi</h1>
            <p>Eng ko'p audio tekshirgan annotatorlar</p>
            <div class="update-time" id="updateTime">Yuklanmoqda...</div>
        </div>

        <div class="leaderboard">
            <div class="leaderboard-header">
                <div>#</div>
                <div>Ism</div>
                <div style="text-align:center">✓ Qabul</div>
                <div style="text-align:center">✗ Rad</div>
                <div style="text-align:center">Jami</div>
                <div style="text-align:center">💰 Balans</div>
            </div>
            <div id="leaderboardBody">
                <% if (leaderboard.length===0) { %>
                    <div class="empty-state">Hali hech kim tekshirmagan.</div>
                    <% } else { %>
                        <% leaderboard.forEach(user=> { %>
                            <div class="leaderboard-row rank-<%= user.rank %>">
                                <div class="rank">
                                    <%= user.rank %>
                                </div>
                                <div class="name">
                                    <%= user.name %>
                                </div>
                                <div class="stat accepted">
                                    <%= user.accepted %>
                                </div>
                                <div class="stat rejected">
                                    <%= user.rejected %>
                                </div>
                                <div class="stat total">
                                    <%= user.total %>
                                </div>
                                <div class="stat balance">
                                    <%= user.balance.toLocaleString() %> so'm
                                </div>
                            </div>
                            <% }); %>
                                <% } %>
            </div>
        </div>

        <div class="feature-list">
            <div class="feature-item">
                <div class="feature-icon">✓</div>
                <span><strong>Auto-refresh</strong> 5s</span>
            </div>
            <div class="feature-item">
                <div class="feature-icon">✓</div>
                <span><strong>Real-time</strong> Jonli</span>
            </div>
            <div class="feature-item">
                <div class="feature-icon">✓</div>
                <span><strong>Top 3</strong> Bonus</span>
            </div>
        </div>
    </div>

    <script>
        function updateLeaderboard() {
            fetch('/api/leaderboard')
                .then(res => res.json())
                .then(data => {
                    if (!data.success) return;

                    const body = document.getElementById('leaderboardBody');

                    if (data.leaderboard.length === 0) {
                        body.innerHTML = '<div class="empty-state">Hali hech kim tekshirmagan.</div>';
                    } else {
                        body.innerHTML = data.leaderboard.map(user => `
                            <div class="leaderboard-row rank-${user.rank}">
                                <div class="rank">${user.rank}</div>
                                <div class="name">${user.name}</div>
                                <div class="stat accepted">${user.accepted}</div>
                                <div class="stat rejected">${user.rejected}</div>
                                <div class="stat total">${user.total}</div>
                                <div class="stat balance">${user.balance.toLocaleString()} so'm</div>
                            </div>
                        `).join('');
                    }

                    // Update time
                    const time = new Date(data.updatedAt).toLocaleTimeString('uz-UZ');
                    document.getElementById('updateTime').textContent = 'Oxirgi yangilanish: ' + time;
                })
                .catch(err => console.error('Update error:', err));
        }

        // Auto-refresh every 5 seconds
        setInterval(updateLeaderboard, 5000);

        // Initial time display
        document.getElementById('updateTime').textContent = 'Oxirgi yangilanish: ' + new Date().toLocaleTimeString('uz-UZ');
    </script>
</body>

</html>