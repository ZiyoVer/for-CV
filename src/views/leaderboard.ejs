<!DOCTYPE html>
<html lang="uz">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leaderboard — STT Annotatorlar</title>
    <style>
        :root {
            --bg-page: #FAF9F6;
            --bg-card: #FFFFFF;
            --bg-hover: #F5F3EF;
            --bg-subtle: #F0EDE6;
            --bg-input: #F7F5F0;
            --text-primary: #1A1714;
            --text-secondary: #6B6560;
            --text-tertiary: #9C9590;
            --border: #E8E4DD;
            --border-subtle: #F0EDE6;
            --accent: #C96442;
            --accent-hover: #B85A3B;
            --accent-light: rgba(201, 100, 66, 0.08);
            --accent-medium: rgba(201, 100, 66, 0.15);
            --success: #2D8A56;
            --success-light: rgba(45, 138, 86, 0.08);
            --error: #C4442A;
            --error-light: rgba(196, 68, 42, 0.08);
            --gold: #B8860B;
            --gold-bg: linear-gradient(135deg, #FDF6E3 0%, #FAF0D4 100%);
            --gold-border: #E8D5A0;
            --silver: #71717A;
            --silver-bg: linear-gradient(135deg, #F7F7F8 0%, #EDEDF0 100%);
            --silver-border: #D4D4D8;
            --bronze: #A0522D;
            --bronze-bg: linear-gradient(135deg, #FBF3ED 0%, #F5E8DC 100%);
            --bronze-border: #DFC4A8;
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 16px;
            --radius-xl: 20px;
            --shadow-sm: 0 1px 2px rgba(26, 23, 20, 0.04);
            --shadow-md: 0 2px 8px rgba(26, 23, 20, 0.06), 0 1px 2px rgba(26, 23, 20, 0.04);
            --shadow-lg: 0 8px 24px rgba(26, 23, 20, 0.08), 0 2px 8px rgba(26, 23, 20, 0.04);
            --transition: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        [data-theme="dark"] {
            --bg-page: #161412;
            --bg-card: #1E1C19;
            --bg-hover: #262420;
            --bg-subtle: #222019;
            --bg-input: #1A1816;
            --text-primary: #F0EDE6;
            --text-secondary: #9C9590;
            --text-tertiary: #6B6560;
            --border: #2E2B26;
            --border-subtle: #262420;
            --accent: #D97757;
            --accent-hover: #E08868;
            --accent-light: rgba(217, 119, 87, 0.1);
            --accent-medium: rgba(217, 119, 87, 0.18);
            --success: #4ADE80;
            --success-light: rgba(74, 222, 128, 0.1);
            --error: #F87171;
            --error-light: rgba(248, 113, 113, 0.1);
            --gold: #FACC15;
            --gold-bg: linear-gradient(135deg, #292518 0%, #2E2810 100%);
            --gold-border: #4A3F1A;
            --silver: #A1A1AA;
            --silver-bg: linear-gradient(135deg, #222222 0%, #262626 100%);
            --silver-border: #3F3F46;
            --bronze: #D97757;
            --bronze-bg: linear-gradient(135deg, #261C16 0%, #2A1E14 100%);
            --bronze-border: #4A3020;
            --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.2);
            --shadow-md: 0 2px 8px rgba(0, 0, 0, 0.25), 0 1px 2px rgba(0, 0, 0, 0.15);
            --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.3), 0 2px 8px rgba(0, 0, 0, 0.2);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', sans-serif;
            background: var(--bg-page);
            color: var(--text-primary);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* ─── Navbar ─── */
        .navbar {
            background: var(--bg-card);
            border-bottom: 1px solid var(--border);
            padding: 0 24px;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        .nav-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .nav-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 15px;
            font-weight: 600;
            color: var(--text-primary);
            letter-spacing: -0.3px;
        }

        .nav-logo svg {
            width: 22px;
            height: 22px;
            color: var(--accent);
        }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .live-badge {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: var(--success);
            background: var(--success-light);
            padding: 5px 10px;
            border-radius: 100px;
        }

        .live-dot {
            width: 6px;
            height: 6px;
            background: var(--success);
            border-radius: 50%;
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.4; }
        }

        .theme-btn {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border);
            background: var(--bg-card);
            color: var(--text-secondary);
            cursor: pointer;
            font-size: 16px;
            transition: all var(--transition);
        }

        .theme-btn:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
        }

        /* ─── Container ─── */
        .container {
            max-width: 720px;
            margin: 0 auto;
            padding: 48px 20px 64px;
        }

        /* ─── Header ─── */
        .header {
            text-align: center;
            margin-bottom: 40px;
        }

        .header-title {
            font-size: 26px;
            font-weight: 650;
            color: var(--text-primary);
            letter-spacing: -0.5px;
            margin-bottom: 6px;
        }

        .header-subtitle {
            font-size: 14px;
            color: var(--text-secondary);
            font-weight: 400;
        }

        .update-info {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin-top: 16px;
            font-size: 12px;
            color: var(--text-tertiary);
            background: var(--bg-subtle);
            padding: 5px 12px;
            border-radius: 100px;
        }

        .update-info svg {
            width: 12px;
            height: 12px;
            opacity: 0.7;
        }

        /* ─── Podium ─── */
        .podium {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 12px;
            margin-bottom: 32px;
        }

        .podium-card {
            position: relative;
            border-radius: var(--radius-lg);
            padding: 28px 16px 24px;
            text-align: center;
            transition: transform var(--transition), box-shadow var(--transition);
            border: 1px solid var(--border);
            overflow: hidden;
        }

        .podium-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-lg);
        }

        .podium-card.gold {
            background: var(--gold-bg);
            border-color: var(--gold-border);
            order: 2;
        }

        .podium-card.silver {
            background: var(--silver-bg);
            border-color: var(--silver-border);
            order: 1;
        }

        .podium-card.bronze {
            background: var(--bronze-bg);
            border-color: var(--bronze-border);
            order: 3;
        }

        .podium-medal {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 14px;
            font-size: 20px;
            font-weight: 700;
        }

        .podium-card.gold .podium-medal {
            background: linear-gradient(135deg, #F5D76E, #D4A017);
            color: #5C3D0A;
            box-shadow: 0 2px 12px rgba(212, 160, 23, 0.3);
        }

        .podium-card.silver .podium-medal {
            background: linear-gradient(135deg, #D4D4D8, #A1A1AA);
            color: #FFF;
            box-shadow: 0 2px 12px rgba(161, 161, 170, 0.3);
        }

        .podium-card.bronze .podium-medal {
            background: linear-gradient(135deg, #D97757, #A0522D);
            color: #FFF;
            box-shadow: 0 2px 12px rgba(160, 82, 45, 0.3);
        }

        .podium-name {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 12px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .podium-score {
            font-size: 24px;
            font-weight: 700;
            color: var(--text-primary);
            letter-spacing: -0.5px;
            margin-bottom: 4px;
        }

        .podium-label {
            font-size: 11px;
            color: var(--text-tertiary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 500;
        }

        .podium-detail {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-top: 14px;
            padding-top: 14px;
            border-top: 1px solid var(--border-subtle);
        }

        .podium-tag {
            font-size: 12px;
            font-weight: 600;
            padding: 3px 8px;
            border-radius: var(--radius-sm);
        }

        .podium-tag.ok {
            color: var(--success);
            background: var(--success-light);
        }

        .podium-tag.no {
            color: var(--error);
            background: var(--error-light);
        }

        /* ─── Leaderboard Table ─── */
        .board {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
        }

        .board-head {
            display: grid;
            grid-template-columns: 52px 1fr 80px 80px 80px;
            padding: 12px 20px;
            background: var(--bg-subtle);
            border-bottom: 1px solid var(--border);
        }

        .board-head span {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-tertiary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .board-head span:nth-child(n+3) {
            text-align: center;
        }

        .board-body {
            /* container for rows */
        }

        .board-row {
            display: grid;
            grid-template-columns: 52px 1fr 80px 80px 80px;
            padding: 14px 20px;
            align-items: center;
            border-bottom: 1px solid var(--border-subtle);
            transition: background var(--transition);
        }

        .board-row:last-child {
            border-bottom: none;
        }

        .board-row:hover {
            background: var(--bg-hover);
        }

        .row-rank {
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-tertiary);
            background: var(--bg-subtle);
            border-radius: var(--radius-sm);
        }

        .board-row:nth-child(1) .row-rank,
        .board-row:nth-child(2) .row-rank,
        .board-row:nth-child(3) .row-rank {
            color: var(--accent);
            background: var(--accent-light);
            font-weight: 700;
        }

        .row-name {
            font-size: 14px;
            font-weight: 500;
            color: var(--text-primary);
            padding-left: 4px;
        }

        .row-stat {
            text-align: center;
            font-size: 14px;
            font-weight: 600;
            font-variant-numeric: tabular-nums;
        }

        .row-stat.ok { color: var(--success); }
        .row-stat.no { color: var(--error); }
        .row-stat.total { color: var(--text-secondary); }

        /* ─── Empty State ─── */
        .empty {
            text-align: center;
            padding: 60px 20px;
        }

        .empty-icon {
            width: 48px;
            height: 48px;
            color: var(--text-tertiary);
            opacity: 0.4;
            margin-bottom: 16px;
        }

        .empty-text {
            font-size: 14px;
            color: var(--text-tertiary);
        }

        /* ─── Footer ─── */
        .footer {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-top: 28px;
            flex-wrap: wrap;
        }

        .footer-tag {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: var(--text-tertiary);
            background: var(--bg-card);
            border: 1px solid var(--border);
            padding: 6px 14px;
            border-radius: 100px;
        }

        .footer-tag .dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--accent);
        }

        /* ─── Responsive ─── */
        @media (max-width: 640px) {
            .container { padding: 28px 14px 48px; }

            .header-title { font-size: 22px; }

            .podium {
                grid-template-columns: 1fr;
                gap: 10px;
            }

            .podium-card { padding: 20px 16px 18px; }

            .podium-card.gold { order: 0; }
            .podium-card.silver { order: 1; }
            .podium-card.bronze { order: 2; }

            .podium-score { font-size: 20px; }

            .board-head,
            .board-row {
                grid-template-columns: 40px 1fr 56px 56px 56px;
                padding: 12px 14px;
            }

            .board-head span { font-size: 10px; }
            .row-name { font-size: 13px; }
            .row-stat { font-size: 13px; }
        }

        /* ─── Animations ─── */
        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .podium { animation: fadeUp 0.5s ease-out; }
        .board { animation: fadeUp 0.5s ease-out 0.1s both; }
    </style>
</head>

<body>

    <nav class="navbar">
        <div class="nav-left">
            <div class="nav-logo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                </svg>
                <span>Leaderboard</span>
            </div>
        </div>
        <div class="nav-right">
            <div class="live-badge">
                <span class="live-dot"></span>
                LIVE
            </div>
            <button class="theme-btn" onclick="toggleTheme()" id="themeBtn" aria-label="Toggle theme">
                <span id="themeIcon">&#9789;</span>
            </button>
        </div>
    </nav>

    <div class="container">

        <div class="header">
            <h1 class="header-title">Annotatorlar Reytingi</h1>
            <p class="header-subtitle">Eng ko'p audio tekshirgan jamoa a'zolari</p>
            <div class="update-info" id="updateTime">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
                <span>Yuklanmoqda...</span>
            </div>
        </div>

        <% if (leaderboard.length >= 3) { %>
        <div class="podium">
            <!-- 1st -->
            <div class="podium-card gold">
                <div class="podium-medal">1</div>
                <div class="podium-name"><%= leaderboard[0].name %></div>
                <div class="podium-score"><%= leaderboard[0].total.toLocaleString() %></div>
                <div class="podium-label">jami tekshiruv</div>
                <div class="podium-detail">
                    <span class="podium-tag ok"><%= leaderboard[0].accepted %></span>
                    <span class="podium-tag no"><%= leaderboard[0].rejected %></span>
                </div>
            </div>
            <!-- 2nd -->
            <div class="podium-card silver">
                <div class="podium-medal">2</div>
                <div class="podium-name"><%= leaderboard[1].name %></div>
                <div class="podium-score"><%= leaderboard[1].total.toLocaleString() %></div>
                <div class="podium-label">jami tekshiruv</div>
                <div class="podium-detail">
                    <span class="podium-tag ok"><%= leaderboard[1].accepted %></span>
                    <span class="podium-tag no"><%= leaderboard[1].rejected %></span>
                </div>
            </div>
            <!-- 3rd -->
            <div class="podium-card bronze">
                <div class="podium-medal">3</div>
                <div class="podium-name"><%= leaderboard[2].name %></div>
                <div class="podium-score"><%= leaderboard[2].total.toLocaleString() %></div>
                <div class="podium-label">jami tekshiruv</div>
                <div class="podium-detail">
                    <span class="podium-tag ok"><%= leaderboard[2].accepted %></span>
                    <span class="podium-tag no"><%= leaderboard[2].rejected %></span>
                </div>
            </div>
        </div>
        <% } %>

        <div class="board">
            <div class="board-head">
                <span>#</span>
                <span>Ism</span>
                <span style="text-align:center">Qabul</span>
                <span style="text-align:center">Rad</span>
                <span style="text-align:center">Jami</span>
            </div>
            <div class="board-body" id="leaderboardBody">
                <% if (leaderboard.length === 0) { %>
                <div class="empty">
                    <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                        <path d="M3 9h18"/>
                        <path d="M9 21V9"/>
                    </svg>
                    <div class="empty-text">Hali hech kim tekshirmagan.</div>
                </div>
                <% } else { %>
                    <% leaderboard.forEach(function(user) { %>
                    <div class="board-row">
                        <div class="row-rank"><%= user.rank %></div>
                        <div class="row-name"><%= user.name %></div>
                        <div class="row-stat ok"><%= user.accepted %></div>
                        <div class="row-stat no"><%= user.rejected %></div>
                        <div class="row-stat total"><%= user.total %></div>
                    </div>
                    <% }); %>
                <% } %>
            </div>
        </div>

        <div class="footer">
            <div class="footer-tag">
                <span class="dot"></span>
                Har 5 sekundda yangilanadi
            </div>
            <div class="footer-tag">
                <span class="dot"></span>
                Jonli ma'lumot
            </div>
        </div>

    </div>

    <script>
        // ─── Theme Toggle ───
        (function() {
            var saved = localStorage.getItem('theme');
            if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
            updateIcon();
        })();

        function toggleTheme() {
            var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            document.documentElement.setAttribute('data-theme', isDark ? 'light' : 'dark');
            localStorage.setItem('theme', isDark ? 'light' : 'dark');
            updateIcon();
        }

        function updateIcon() {
            var icon = document.getElementById('themeIcon');
            if (!icon) return;
            var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            icon.textContent = isDark ? '\u2600' : '\u263D';
        }

        // ─── Live Leaderboard ───
        var escapeHtml = function(text) {
            var d = document.createElement('div');
            d.textContent = text;
            return d.innerHTML;
        };

        function updateLeaderboard() {
            fetch('/api/leaderboard')
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (!data.success) return;

                    var body = document.getElementById('leaderboardBody');

                    if (data.leaderboard.length === 0) {
                        body.innerHTML = '<div class="empty"><svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg><div class="empty-text">Hali hech kim tekshirmagan.</div></div>';
                    } else {
                        body.innerHTML = data.leaderboard.map(function(u) {
                            return '<div class="board-row">'
                                + '<div class="row-rank">' + u.rank + '</div>'
                                + '<div class="row-name">' + escapeHtml(u.name) + '</div>'
                                + '<div class="row-stat ok">' + u.accepted + '</div>'
                                + '<div class="row-stat no">' + u.rejected + '</div>'
                                + '<div class="row-stat total">' + u.total + '</div>'
                                + '</div>';
                        }).join('');
                    }

                    // Update timestamp
                    var t = new Date(data.updatedAt).toLocaleTimeString('uz-UZ', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                    document.getElementById('updateTime').innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg><span>' + t + '</span>';
                })
                .catch(function(err) { console.error('Update error:', err); });
        }

        // Refresh every 5 seconds
        setInterval(updateLeaderboard, 5000);

        // Set initial time
        var now = new Date().toLocaleTimeString('uz-UZ', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        document.getElementById('updateTime').innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg><span>' + now + '</span>';
    </script>

</body>

</html>