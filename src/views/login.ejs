<!DOCTYPE html>
<html lang="uz">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>STT Admin - Kirish</title>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'JetBrains Mono', monospace;
            background: #0a0a0a;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #e5e5e5;
        }

        .login-card {
            background: #111;
            border: 1px solid #222;
            padding: 48px;
            width: 100%;
            max-width: 480px;
        }

        h1 {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 8px;
            color: #fff;
        }

        .subtitle {
            color: #666;
            margin-bottom: 32px;
            font-size: 14px;
        }

        .form-group {
            margin-bottom: 24px;
        }

        label {
            display: block;
            color: #888;
            margin-bottom: 8px;
            font-size: 13px;
        }

        input[type="password"] {
            width: 100%;
            padding: 14px 16px;
            background: #0a0a0a;
            border: 1px solid #333;
            color: #fff;
            font-size: 14px;
            font-family: 'JetBrains Mono', monospace;
            transition: border-color 0.2s;
        }

        input[type="password"]:focus {
            outline: none;
            border-color: #fff;
        }

        button {
            background: #fff;
            color: #000;
            border: none;
            padding: 12px 24px;
            font-size: 14px;
            font-weight: 500;
            font-family: 'JetBrains Mono', monospace;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: opacity 0.2s;
        }

        button:hover {
            opacity: 0.8;
        }

        .error {
            background: rgba(255, 50, 50, 0.1);
            border: 1px solid #ff3232;
            color: #ff6b6b;
            padding: 12px;
            margin-bottom: 20px;
            font-size: 13px;
        }

        .feature-list {
            margin-top: 32px;
            padding-top: 32px;
            border-top: 1px solid #222;
        }

        .feature-item {
            display: flex;
            gap: 12px;
            margin-bottom: 12px;
            font-size: 13px;
            color: #888;
        }

        .feature-item span:first-child {
            color: #555;
        }

        .feature-item strong {
            color: #e5e5e5;
        }
    </style>
</head>

<body>
    <div class="login-card">
        <h1>STT Admin Panel</h1>
        <p class="subtitle">Speech-to-Text tekshiruv tizimi boshqaruvi</p>

        <% if (error) { %>
            <div class="error">
                <%= error %>
            </div>
            <% } %>

                <form method="POST" action="/login">
                    <div class="form-group">
                        <label>Admin Parol</label>
                        <input type="password" name="password" placeholder="••••••••" required autofocus>
                    </div>
                    <button type="submit">Kirish →</button>
                </form>

                <div class="feature-list">
                    <div class="feature-item">
                        <span>[*]</span>
                        <span><strong>Dashboard</strong> Umumiy statistika va foydalanuvchilar</span>
                    </div>
                    <div class="feature-item">
                        <span>[*]</span>
                        <span><strong>Review</strong> Annotatorlar ishini tekshirish</span>
                    </div>
                    <div class="feature-item">
                        <span>[*]</span>
                        <span><strong>Payments</strong> Balans va to'lovlarni boshqarish</span>
                    </div>
                </div>
    </div>
</body>

</html>