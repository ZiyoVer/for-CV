<!DOCTYPE html>
<html lang="uz">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>STT Admin - Kirish</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: #ffffff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #1a1a1a;
        }

        .login-card {
            background: #fafafa;
            border: 1px solid #e5e5e5;
            border-radius: 16px;
            padding: 48px;
            width: 100%;
            max-width: 440px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
        }

        h1 {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 8px;
            color: #0a0a0a;
            letter-spacing: -0.5px;
        }

        .subtitle {
            color: #737373;
            margin-bottom: 32px;
            font-size: 14px;
        }

        .form-group {
            margin-bottom: 24px;
        }

        label {
            display: block;
            color: #525252;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 500;
        }

        input[type="password"] {
            width: 100%;
            padding: 14px 16px;
            background: #ffffff;
            border: 1px solid #e5e5e5;
            color: #0a0a0a;
            font-size: 14px;
            font-family: 'Inter', sans-serif;
            border-radius: 8px;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        input[type="password"]:focus {
            outline: none;
            border-color: #0a0a0a;
            box-shadow: 0 0 0 3px rgba(10, 10, 10, 0.1);
        }

        button {
            width: 100%;
            background: #0a0a0a;
            color: #ffffff;
            border: none;
            padding: 14px 24px;
            font-size: 14px;
            font-weight: 600;
            font-family: 'Inter', sans-serif;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s;
            border-radius: 8px;
        }

        button:hover {
            background: #262626;
            transform: translateY(-1px);
        }

        .error {
            background: #fef2f2;
            border: 1px solid #fee2e2;
            color: #dc2626;
            padding: 12px;
            margin-bottom: 24px;
            font-size: 13px;
            border-radius: 8px;
            font-weight: 500;
        }

        .feature-list {
            margin-top: 32px;
            padding-top: 32px;
            border-top: 1px solid #e5e5e5;
        }

        .feature-item {
            display: flex;
            gap: 12px;
            margin-bottom: 12px;
            font-size: 13px;
            color: #525252;
            align-items: center;
        }

        .feature-icon {
            width: 20px;
            height: 20px;
            border-radius: 5px;
            background: #f0fdf4;
            color: #16a34a;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
        }

        .feature-item strong {
            color: #0a0a0a;
            font-weight: 600;
        }
    </style>
</head>

<body>
    <div class="login-card">
        <h1>STT Admin Panel</h1>
        <p class="subtitle">Speech-to-Text tekshiruv tizimi boshqaruvi</p>

        <% if (error) { %>
            <div class="error">
                <%= error %>
            </div>
            <% } %>

                <form method="POST" action="/login">
                    <div class="form-group">
                        <label>Admin Parol</label>
                        <input type="password" name="password" placeholder="••••••••" required autofocus>
                    </div>
                    <button type="submit">Kirish →</button>
                </form>

                <div class="feature-list">
                    <div class="feature-item">
                        <div class="feature-icon">✓</div>
                        <span><strong>Dashboard</strong> Umumiy statistika va foydalanuvchilar</span>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon">✓</div>
                        <span><strong>Review</strong> Annotatorlar ishini tekshirish</span>
                    </div>
                    <div class="feature-item">
                        <div class="feature-icon">✓</div>
                        <span><strong>Payments</strong> Balans va to'lovlarni boshqarish</span>
                    </div>
                </div>
    </div>
</body>

</html>